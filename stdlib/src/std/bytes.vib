; Byte sequences. Every operation is Vibra over the bytes a `bytes` value is
; written over; `native:` names the implementation a toolchain may run instead.
(import core @std.core)

; The standard byte-sequence type, which plays the `@bytes` role. It is written
; over its bytes, and the toolchain represents it directly; `(bytes items)` and
; the pattern `(bytes items)` convert between it and its `(array u8)`.
(deftype bytes (array u8)
  role: @bytes
  visibility: @public
  (defn length (value bytes) u64
    visibility: @public
    native: "bytes.length"
    (let (bytes items) value)
    (array.length items))
  (defn concat (left bytes right bytes) bytes
    visibility: @public
    native: "bytes.concat"
    (let (bytes first) left)
    (let (bytes second) right)
    (bytes (array.concat first second)))
  (defn slice (value bytes start u64 end u64) (option bytes)
    visibility: @public
    native: "bytes.slice"
    (let (bytes items) value)
    (match (array.slice items start end)
      (option.some part) (option.some (bytes part))
      (option.none) (option.none)))
  (impl equatable
    (defn equal (left self right self) bool
      native: "bytes.equal"
      (match (ordered.compare left right) (core.ordering.equal) true - false)))
  (impl ordered
    (defn compare (left self right self) core.ordering
      native: "bytes.compare"
      (let (bytes first) left)
      (let (bytes second) right)
      (order first second 0u64))))

; Lexicographic order from `index`: the first differing byte decides, and a
; proper prefix is less.
(defn order (first (array u8) second (array u8) index u64) core.ordering
  (match (tupleof (first index) (second index))
    (tupleof (option.none) (option.none)) (core.ordering.equal)
    (tupleof (option.none) -) (core.ordering.less)
    (tupleof - (option.none)) (core.ordering.greater)
    (tupleof (option.some left) (option.some right))
      (match (ordered.compare left right)
        (core.ordering.equal) (order first second (plus index 1u64))
        decided decided)))

; Index arithmetic the callers keep in range. A result outside `u64` would be
; a defect in this module, and it saturates rather than trapping.
(defn plus (left u64 right u64) u64
  (match (u64.add left right)
    (result.ok sum) sum
    (result.err -) 18446744073709551615u64))

// The process environment: the two operation interfaces of the `env` rows of
// the host registry and their error type. Each interface binds its one
// operation with `external @host` and its narrowing member `limit` with
// `external @compiler`; both are the implementation of a sealed grant only,
// so an `impl` supplies them.

use @std.policy.GrantLimits enduse

type EnvError
  case notPresent
  case notUnicode
  case denied
  case limitExceeded
  case unsupported
  case outcomeUnknown
  visibility @public
endtype

interface EnvReadVar
  visibility @public
  proc read
    takes {grant: Self name: Str}
    returns outcome: Result(Str EnvError)
    external @host
    symbol "env.readVar"
  endproc
  fn limit
    takes {grant: Self limits: GrantLimits}
    returns narrowed: Self
    external @compiler
    symbol "grant.limit"
  endfn
endinterface

interface EnvReadArgs
  visibility @public
  proc read
    takes {grant: Self}
    returns outcome: Result(List(Str) EnvError)
    external @host
    symbol "env.readArgs"
  endproc
  fn limit
    takes {grant: Self limits: GrantLimits}
    returns narrowed: Self
    external @compiler
    symbol "grant.limit"
  endfn
endinterface

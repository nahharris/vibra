; Environment reads (`docs/spec/06-runtime.md`, "The host registry"). Each
; operation is bound to its row of the closed host registry. The error is a
; closed enum whose variants all have `void` payloads.
(deftype env-error (enum not-present void not-unicode void) visibility: @public)

(deffect read
  visibility: @public
  (defn var (name str) (result str env-error)
    visibility: @public
    external: @host
    symbol: "env.read-var")
  (defn args () (result (array str) env-error)
    visibility: @public
    external: @host
    symbol: "env.read-args"))

; Ordering and the error types of the checked numeric and conversion
; operations. Every variant has a `void` payload.
(deftype ordering (enum less void equal void greater void)
  visibility: @public)

(deftype arithmetic-error
  (enum overflow void division-by-zero void invalid-shift void)
  visibility: @public)

(deftype conversion-error
  (enum out-of-range void invalid-format void unrepresentable void)
  visibility: @public)

; The comparison contracts (`docs/spec/02-type-system.md`, "Nominal
; declarations"). The key primitives, atom singletons, and anonymous
; structures of admissible keys conform through the closed toolchain registry.
(defint equatable
  visibility: @public
  (defn equal (left self right self) bool))

(defint ordered
  visibility: @public
  (defn compare (left self right self) ordering))

; Ordering and the error types of the checked numeric and conversion
; operations. Every variant has a `void` payload.
(deftype ordering (enum less void equal void greater void)
  visibility: @public)

(deftype arithmetic-error
  (enum overflow void division-by-zero void invalid-shift void)
  visibility: @public)

(deftype conversion-error
  (enum out-of-range void invalid-format void unrepresentable void)
  visibility: @public)

; The comparison contracts (`docs/spec/02-type-system.md`, "Nominal
; declarations"). They play `@equatable` and `@ordered`, so every module names
; them without an import. Each type implements them where it is declared: the
; builtin integers and `char` in `@std.builtin`, and `bool`, `str`, and `bytes`
; in their own modules. Atom types and anonymous structures of admissible keys
; conform through the closed toolchain registry, which answers every closed key
; type as these implementations do.
(defint equatable
  role: @equatable
  visibility: @public
  (defn equal (left self right self) bool))

(defint ordered
  role: @ordered
  visibility: @public
  (defn compare (left self right self) ordering))

; The conversion contracts (`docs/spec/02-type-system.md`, "Conversion"). Both
; are implemented on the destination and name `self` only in their result, so
; a call selects its implementation from the written expected type. The
; builtin numbers implement them in `@std.builtin`: an integer conversion that
; cannot fail is a `from`, every other one a `try-from`, and parsing text is a
; `try-from str`. `str` implements `from` for each number it renders.
(defint from
  where: (source any)
  visibility: @public
  (defn convert (value source) self))

(defint try-from
  where: (source any)
  visibility: @public
  (defn convert (value source) (result self conversion-error)))

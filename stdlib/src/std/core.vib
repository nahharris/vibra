// The core types and contracts of the standard library: the order of two
// values, the errors of the checked numeric and conversion operations, the
// comparison interfaces, the bound of a canonical encoding, and the conversion
// interfaces.

type Ordering
  case less
  case equal
  case greater
  visibility @public
endtype

type ArithmeticError
  case overflow
  case divisionByZero
  case invalidShift
  visibility @public
endtype

type ConversionError
  case outOfRange
  case invalidFormat
  case unrepresentable
  visibility @public
endtype

interface Equatable
  role @equatable
  visibility @public
  fn equal
    takes {left: Self right: Self}
    returns same: Bool
  endfn
endinterface

interface Ordered
  role @ordered
  visibility @public
  fn compare
    takes {left: Self right: Self}
    returns order: Ordering
  endfn
  fn less
    takes {left: Self right: Self}
    returns holds: Bool
    do
      match Ordered.compare(left right)
        case Ordering.less()
          return true
        case _
          return false
      endmatch
  endfn
  fn lessOrEqual
    takes {left: Self right: Self}
    returns holds: Bool
    do
      match Ordered.compare(left right)
        case Ordering.greater()
          return false
        case _
          return true
      endmatch
  endfn
  fn greater
    takes {left: Self right: Self}
    returns holds: Bool
    do
      match Ordered.compare(left right)
        case Ordering.greater()
          return true
        case _
          return false
      endmatch
  endfn
  fn greaterOrEqual
    takes {left: Self right: Self}
    returns holds: Bool
    do
      match Ordered.compare(left right)
        case Ordering.less()
          return false
        case _
          return true
      endmatch
  endfn
  fn min
    takes {left: Self right: Self}
    returns least: Self
    do
      match Ordered.compare(left right)
        case Ordering.greater()
          return right
        case _
          return left
      endmatch
  endfn
  fn max
    takes {left: Self right: Self}
    returns greatest: Self
    do
      match Ordered.compare(left right)
        case Ordering.less()
          return right
        case _
          return left
      endmatch
  endfn
  fn inRange
    takes {value: Self low: Self high: Self}
    returns holds: Bool
    do
      match Ordered.compare(value low)
        case Ordering.less()
          return false
        case _
          match Ordered.compare(value high)
            case Ordering.greater()
              return false
            case _
              return true
          endmatch
      endmatch
  endfn
endinterface

// A type conforms structurally, with no implementation, when its static type
// shows a canonical value encoding (`docs/spec/06-runtime.md`, "What has no
// encoding").
interface Encodable
  role @encodable
  visibility @public
endinterface

interface From(Source)
  visibility @public
  fn convert
    takes {value: Source}
    returns converted: Self
  endfn
endinterface

interface TryFrom(Source)
  visibility @public
  type Error endtype
  fn convert
    takes {value: Source}
    returns converted: Result(Self Error)
  endfn
endinterface

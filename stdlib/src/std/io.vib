; Console input and output (`docs/spec/06-runtime.md`, "The host registry").
; Each operation reads or writes a whole value in one call and is bound to its
; row of the closed host registry. The error is a closed enum whose variants all
; have `void` payloads.
(deftype io-error (enum invalid-text void closed void other void) visibility: @public)

(deffect stdin
  visibility: @public
  (defn text () (result str io-error)
    visibility: @public
    external: @host
    symbol: "io.stdin-text")
  (defn bytes () (result bytes io-error)
    visibility: @public
    external: @host
    symbol: "io.stdin-bytes"))

(deffect stdout
  visibility: @public
  (defn text (value str) (result void io-error)
    visibility: @public
    external: @host
    symbol: "io.stdout-text")
  (defn bytes (value bytes) (result void io-error)
    visibility: @public
    external: @host
    symbol: "io.stdout-bytes"))

(deffect stderr
  visibility: @public
  (defn text (value str) (result void io-error)
    visibility: @public
    external: @host
    symbol: "io.stderr-text")
  (defn bytes (value bytes) (result void io-error)
    visibility: @public
    external: @host
    symbol: "io.stderr-bytes"))

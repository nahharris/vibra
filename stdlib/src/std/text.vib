; Text. Every operation is Vibra over the Unicode scalars a `str` is written
; over; `native:` names the implementation a toolchain may run instead.
(import core @std.core)
(import from @std.core.from)
(import try-from @std.core.try-from)

; The standard string type, which plays the `@str` role: string literals have
; this type. It is written over its Unicode scalars, and the toolchain
; represents it directly; `(str scalars)` and the pattern `(str scalars)`
; convert between it and its `(array char)`. Each number renders as its
; `from` conversion.
(deftype str (array char)
  role: @str
  visibility: @public
  (defn concat (left str right str) str
    visibility: @public
    native: "text.concat"
    (let (str first) left)
    (let (str second) right)
    (str (array.concat first second)))
  (defn length (value str) u64
    visibility: @public
    native: "text.length"
    (let (str scalars) value)
    (array.length scalars))
  (defn slice (value str start u64 end u64) (option str)
    visibility: @public
    native: "text.slice"
    (let (str scalars) value)
    (match (array.slice scalars start end)
      (option.some piece) (option.some (str piece))
      (option.none) (option.none)))
  (defn to-utf8 (value str) bytes
    visibility: @public
    native: "text.to-utf8"
    (let (str scalars) value)
    (bytes (encode scalars 0u64 (array.of))))
  (defn from-utf8 (encoded bytes) (result str core.conversion-error)
    visibility: @public
    native: "text.from-utf8"
    (let (bytes items) encoded)
    (decode items 0u64 (array.of)))
  ; The operations below are reviewed Vibra over the operations above.
  (defn starts-with (value str prefix str) bool
    visibility: @public
    (match (str.slice value 0u64 (str.length prefix))
      (option.some head) (equatable.equal head prefix)
      (option.none) false))
  (defn ends-with (value str suffix str) bool
    visibility: @public
    (match (u64.sub-checked (str.length value) (str.length suffix))
      (result.ok start)
        (match (str.slice value start (str.length value))
          (option.some tail) (equatable.equal tail suffix)
          (option.none) false)
      (result.err -) false))
  (defn index-of (value str needle str) (option u64)
    visibility: @public
    (search value needle 0u64))
  (defn contains (value str needle str) bool
    visibility: @public
    (match (str.index-of value needle) (option.some -) true (option.none) false))
  (defn split (value str separator str) (array str)
    visibility: @public
    (if (equatable.equal (str.length separator) 0u64)
      (array.of value)
      (split-from value separator 0u64 (array.of))))
  (defn trim-start (value str) str
    visibility: @public
    (let (str scalars) value)
    (part value (first-content scalars 0u64) (str.length value)))
  (defn trim-end (value str) str
    visibility: @public
    (let (str scalars) value)
    (part value 0u64 (last-content scalars (str.length value))))
  (defn trim (value str) str
    visibility: @public
    (let (str scalars) value)
    (part
      value
      (first-content scalars 0u64)
      (last-content scalars (str.length value))))
  (impl equatable
    (defn equal (left self right self) bool
      native: "text.equal"
      (match (ordered.compare left right) (core.ordering.equal) true - false)))
  (impl ordered
    (defn compare (left self right self) core.ordering
      native: "text.compare"
      (let (str first) left)
      (let (str second) right)
      (order first second 0u64)))
  (impl (from i8)
    (defn convert (value i8) self
      external: @compiler
      symbol: "i8.to-str"))
  (impl (from i16)
    (defn convert (value i16) self
      external: @compiler
      symbol: "i16.to-str"))
  (impl (from i32)
    (defn convert (value i32) self
      external: @compiler
      symbol: "i32.to-str"))
  (impl (from i64)
    (defn convert (value i64) self
      external: @compiler
      symbol: "i64.to-str"))
  (impl (from u8)
    (defn convert (value u8) self
      external: @compiler
      symbol: "u8.to-str"))
  (impl (from u16)
    (defn convert (value u16) self
      external: @compiler
      symbol: "u16.to-str"))
  (impl (from u32)
    (defn convert (value u32) self
      external: @compiler
      symbol: "u32.to-str"))
  (impl (from u64)
    (defn convert (value u64) self
      external: @compiler
      symbol: "u64.to-str"))
  (impl (from f32)
    (defn convert (value f32) self
      external: @compiler
      symbol: "f32.to-str"))
  (impl (from f64)
    (defn convert (value f64) self
      external: @compiler
      symbol: "f64.to-str")))

(defn part (value str start u64 end u64) str
  (match (str.slice value start end) (option.some piece) piece (option.none) ""))

(defn search (value str needle str start u64) (option u64)
  (match (str.slice value start (u64.add start (str.length needle)))
    (option.some window)
      (if (equatable.equal window needle)
        (option.some start)
        (search value needle (u64.add start 1u64)))
    (option.none) (option.none)))

(defn split-from (value str separator str start u64 parts (array str)) (array str)
  (match (search value separator start)
    (option.some at)
      (split-from
        value
        separator
        (u64.add at (str.length separator))
        (array.append parts (part value start at)))
    (option.none) (array.append parts (part value start (str.length value)))))

(defn first-content (scalars (array char) index u64) u64
  (match (scalars index)
    (option.some scalar)
      (if (char.is-ascii-whitespace scalar)
        (first-content scalars (u64.add index 1u64))
        index)
    (option.none) index))

(defn last-content (scalars (array char) end u64) u64
  (match (u64.sub-checked end 1u64)
    (result.ok before)
      (match (scalars before)
        (option.some scalar)
          (if (char.is-ascii-whitespace scalar) (last-content scalars before) end)
        (option.none) end)
    (result.err -) end))

; Lexicographic order by scalar value from `index`: the first differing
; scalar decides, and a proper prefix is less.
(defn order (first (array char) second (array char) index u64) core.ordering
  (match (tupleof (first index) (second index))
    (tupleof (option.none) (option.none)) (core.ordering.equal)
    (tupleof (option.none) -) (core.ordering.less)
    (tupleof - (option.none)) (core.ordering.greater)
    (tupleof (option.some left) (option.some right))
      (match (ordered.compare left right)
        (core.ordering.equal) (order first second (u64.add index 1u64))
        decided decided)))

; The UTF-8 bytes of the scalars from `index`, appended to `out`.
(defn encode (scalars (array char) index u64 out (array u8)) (array u8)
  (match (scalars index)
    (option.some scalar)
      (encode
        scalars
        (u64.add index 1u64)
        (array.concat out (utf8-of (char.to-u32 scalar))))
    (option.none) out))

(defn utf8-of (scalar u32) (array u8)
  (if (within scalar 0u32 127u32)
    (array.of (byte scalar))
    (if (within scalar 128u32 2047u32)
      (array.of (lead 192u32 scalar 64u32) (trail scalar 1u32))
      (if (within scalar 2048u32 65535u32)
        (array.of
          (lead 224u32 scalar 4096u32)
          (trail scalar 64u32)
          (trail scalar 1u32))
        (array.of
          (lead 240u32 scalar 262144u32)
          (trail scalar 4096u32)
          (trail scalar 64u32)
          (trail scalar 1u32))))))

; A leading byte: `marker` plus the scalar's bits above `unit`.
(defn lead (marker u32 scalar u32 unit u32) u8
  (byte (u32.add marker (u32.div scalar unit))))

; A continuation byte: `0b10` and the six scalar bits at `unit`.
(defn trail (scalar u32 unit u32) u8
  (byte (u32.add 128u32 (u32.rem (u32.div scalar unit) 64u32))))

; The scalars of well-formed UTF-8 from `index`, appended to `out`.
(defn decode (items (array u8) index u64 out (array char))
  (result str core.conversion-error)
  (match (items index)
    (option.none) (result.ok (str out))
    (option.some first)
      (match (sequence items index (wide first))
        (option.some (tupleof scalar width))
          (match (char.from-u32 scalar)
            (option.some decoded)
              (decode items (u64.add index width) (array.append out decoded))
            (option.none) (result.err (core.conversion-error.invalid-format)))
        (option.none) (result.err (core.conversion-error.invalid-format)))))

; The scalar and byte width of the sequence starting with `first` at `index`,
; or none when it is ill-formed: overlong forms, surrogates, and values above
; U+10FFFF have no well-formed sequence.
(defn sequence (items (array u8) index u64 first u32) (option (tuple u32 u64))
  (if (within first 0u32 127u32)
    (option.some (tupleof first 1u64))
    (if (within first 194u32 223u32)
      (match (continuation items index 1u64 128u32 191u32)
        (option.some second)
          (option.some
            (tupleof (u32.add (u32.mul (u32.sub first 192u32) 64u32) second) 2u64))
        (option.none) (option.none))
      (if (within first 224u32 239u32)
        (three items index first)
        (if (within first 240u32 244u32) (four items index first) (option.none))))))

(defn three (items (array u8) index u64 first u32) (option (tuple u32 u64))
  (match
    (tupleof
      (continuation
        items
        index
        1u64
        (if (equatable.equal first 224u32) 160u32 128u32)
        (if (equatable.equal first 237u32) 159u32 191u32))
      (continuation items index 2u64 128u32 191u32))
    (tupleof (option.some second) (option.some third))
      (option.some
        (tupleof
          (u32.add
            (u32.add (u32.mul (u32.sub first 224u32) 4096u32) (u32.mul second 64u32))
            third)
          3u64))
    - (option.none)))

(defn four (items (array u8) index u64 first u32) (option (tuple u32 u64))
  (match
    (tupleof
      (continuation
        items
        index
        1u64
        (if (equatable.equal first 240u32) 144u32 128u32)
        (if (equatable.equal first 244u32) 143u32 191u32))
      (continuation items index 2u64 128u32 191u32)
      (continuation items index 3u64 128u32 191u32))
    (tupleof (option.some second) (option.some third) (option.some fourth))
      (option.some
        (tupleof
          (u32.add
            (u32.add
              (u32.add
                (u32.mul (u32.sub first 240u32) 262144u32)
                (u32.mul second 4096u32))
              (u32.mul third 64u32))
            fourth)
          4u64))
    - (option.none)))

; The six payload bits of the continuation byte at `index + offset`, when it
; lies in `[low, high]`.
(defn continuation (items (array u8) index u64 offset u64 low u32 high u32)
  (option u32)
  (match (items (u64.add index offset))
    (option.some found)
      (if (within (wide found) low high)
        (option.some (u32.sub (wide found) 128u32))
        (option.none))
    (option.none) (option.none)))

(defn within (value u32 low u32 high u32) bool
  (match (ordered.compare value low)
    (core.ordering.less) false
    - (match (ordered.compare value high) (core.ordering.greater) false - true)))

; A `u32` below 256 as a byte, and a byte as a `u32`.
(defn byte (value u32) u8
  (match (as (result u8 core.conversion-error) (try-from.convert value))
    (result.ok narrow) narrow
    (result.err -) 255u8))

(defn wide (value u8) u32
  (from.convert value))

; A Unicode scalar value. It orders by scalar value, and its ASCII classes are
; Vibra over `to-u32`.
(deftype char (intrinsic-type @char)
  visibility: @public
  (defn to-u32 (value char) u32
    visibility: @public
    external: @compiler
    symbol: "char.to-u32")
  (defn from-u32 (scalar u32) (option char)
    visibility: @public
    external: @compiler
    symbol: "char.from-u32")
  ; Whether `value` lies in `[low, high]`.
  (defn in-range (value char low char high char) bool
    visibility: @public
    (match (ordered.compare value low)
      (core.ordering.less) false
      - (match (ordered.compare value high) (core.ordering.greater) false - true)))
  (defn is-ascii-digit (value char) bool
    visibility: @public
    (char.in-range value \0 \9))
  (defn is-ascii-upper (value char) bool
    visibility: @public
    (char.in-range value \A \Z))
  (defn is-ascii-lower (value char) bool
    visibility: @public
    (char.in-range value \a \z))
  (defn is-ascii-letter (value char) bool
    visibility: @public
    (if (char.is-ascii-upper value) true (char.is-ascii-lower value)))
  ; Space, tab, line feed, form feed, and carriage return.
  (defn is-ascii-whitespace (value char) bool
    visibility: @public
    (match (char.to-u32 value)
      32u32 true
      9u32 true
      10u32 true
      12u32 true
      13u32 true
      - false))
  (impl equatable
    (defn equal (left self right self) bool
      (equatable.equal (char.to-u32 left) (char.to-u32 right))))
  (impl ordered
    (defn compare (left self right self) core.ordering
      (ordered.compare (char.to-u32 left) (char.to-u32 right)))))

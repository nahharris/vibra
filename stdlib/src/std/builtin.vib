; Members of the builtin types. They are reached through the type path, such
; as `(array.of 1i32 2i32)` or `(i32.add-checked 1i32 2i32)`, with no import.
; `external:` members are primitive operations; `native:` members are Vibra
; whose native implementation the toolchain may run instead, and the others
; are Vibra alone. Each type implements the comparison and conversion
; contracts of `@std.core` here, where it is declared.
(import core @std.core)
(import option @std.option)

(deftype array (intrinsic-type @array)
  where: (t any)
  visibility: @public
  (defn of () (array t)
    visibility: @public
    variadic: (items (array t))
    native: "array.of"
    items)
  (defn length (items (array t)) u64
    visibility: @public
    external: @compiler
    symbol: "array.length")
  (defn append (items (array t) item t) (array t)
    visibility: @public
    external: @compiler
    symbol: "array.append")
  (defn concat (left (array t) right (array t)) (array t)
    visibility: @public
    external: @compiler
    symbol: "array.concat")
  (defn slice (items (array t) start u64 end u64) (option.option (array t))
    visibility: @public
    external: @compiler
    symbol: "array.slice")
  ; The left fold: `step` combines the accumulator with each element in order.
  (defn fold (items (array t) initial a step (fn (a t) a)) a
    where: (a any)
    visibility: @public
    native: "array.fold"
    (match (items 0u64)
      (option.option.none) initial
      (option.option.some first)
        (match (array.slice items 1u64 (array.length items))
          (option.option.some rest) (array.fold rest (step initial first) step)
          (option.option.none) initial))))

; The standard dict, which plays the `@dict` role: its entries sorted by
; `ordered.compare` on their keys, one entry per key. The toolchain represents
; it directly; building one sorts and merges its entries, so a later entry for
; the same key wins.
(deftype dict (array (tuple k v))
  where: (k ordered v any)
  role: @dict
  visibility: @public
  (defn of () (dict k v)
    visibility: @public
    variadic: (entries (dict k v))
    native: "dict.of"
    entries)
  ; The entries in key order, which is how a dict is traversed and rendered.
  (defn entries (value (dict k v)) (array (tuple k v))
    visibility: @public
    external: @compiler
    symbol: "dict.entries"))


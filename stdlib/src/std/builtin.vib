// The builtin types: the compiler owns their representation, written
// `Intrinsic(@tag)` with the type's wire tag, and their static members are
// bound to `@compiler` intrinsics. The module is in every checked graph and is
// never imported; its public declarations are reached through the prelude.
// `Dict`, whose representation is private, is declared here with its role.

use @std.core.ArithmeticError enduse

use @std.core.ConversionError enduse

type Void of Intrinsic(@void)
  visibility @public
endtype

type Never of Intrinsic(@never)
  visibility @public
endtype

type Atom of Intrinsic(@atom)
  visibility @public
endtype

type Char of Intrinsic(@char)
  visibility @public
  fn toU32
    takes {value: Self}
    returns scalar: U32
    visibility @public
    external @compiler
    symbol "char.toU32"
  endfn
  fn fromU32
    takes {scalar: U32}
    returns value: Option(Self)
    visibility @public
    external @compiler
    symbol "char.fromU32"
  endfn
  fn isAsciiDigit
    takes {value: Self}
    returns holds: Bool
    visibility @public
    do
      return Ordered.inRange(value '0' '9')
  endfn
  fn isAsciiAlphabetic
    takes {value: Self}
    returns holds: Bool
    visibility @public
    do
      return Bool.or(Ordered.inRange(value 'A' 'Z') Ordered.inRange(value 'a' 'z'))
  endfn
  fn isAsciiWhitespace
    takes {value: Self}
    returns holds: Bool
    visibility @public
    do
      return Bool.or(
        Bool.or(Equatable.equal(value ' ') Equatable.equal(value '\t'))
        Bool.or(Equatable.equal(value '\n') Equatable.equal(value '\r'))
      )
  endfn
  impl Equatable
    fn equal
      takes {left: Self right: Self}
      returns same: Bool
      do
        return Equatable.equal(Char.toU32(left) Char.toU32(right))
    endfn
  endimpl
  impl Ordered
    fn compare
      takes {left: Self right: Self}
      returns order: Ordering
      do
        return Ordered.compare(Char.toU32(left) Char.toU32(right))
    endfn
  endimpl
endtype


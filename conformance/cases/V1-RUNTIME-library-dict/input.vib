(defn main () (tuple (array (tuple str i32)) (array (tuple point str)) u64)
  (tupleof
    (dict.entries (dict.of "b" 2i32 "a" 1i32 "b" 3i32))
    (dict.entries (dict.of (point x: 1i32 y: 2i32) "a" (point x: 2i32 y: 1i32) "b"))
    (array.length (dict.entries (as (dict str i32) (dict.of))))))

(import core @std.core)
(import ordered @std.core.ordered)

(deftype point (record x i32 y i32)
  (impl ordered
    (defn compare (left self right self) core.ordering
      (match (i32.compare (left @y) (right @y))
        (core.ordering.equal) (i32.compare (left @x) (right @x))
        order order))))

(defn odd () (dict str i32) (dict.of "a" 1i32 "b"))

(defn mixed () (array i32) (array.of 1i32 "x"))

(defn empty () i32 (let items (array.of)) 0i32)

(defn outside () i32 ((tupleof 1i32 "x") 2))

(defn padded () i32 ((tupleof 1i32 "x") 00))

(defn inside () i32 ((tupleof 1i32 "x") 0))

(defn padded-one () i32 ((tupleof 1i32 "x") 01))

(defn suffixed () i32 ((tupleof 1i32 "x") 1u64))

(defn one-key-short () (dict str i32) (dict.of "a"))

(defn no-reverse () (array i32) (array.reverse (array.of 1i32)))

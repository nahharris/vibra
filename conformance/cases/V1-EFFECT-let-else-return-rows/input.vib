(deffect write
  (defn text (target str) void (do)))

(defn see () (option i32)
  effects: (write)
  (write.text "a")
  (option.some 1i32))

(defn by-let () i32
  (let seen (see))
  0i32)

(defn by-fallback (o (option i32)) i32
  (let-else (option.some v) o (do (see) (return 0i32)))
  v)

(defn by-return (c bool) i32
  (let - (if c (return (do (see) 1i32)) 2i32))
  0i32)

(defn by-let-else-value (o (option i32)) i32
  (let-else (option.some v) (see) (return 0i32))
  v)

(defn within-let (o (option i32) c bool) i32
  effects: (write)
  (let seen (see))
  0i32)

(defn within-let-else-value (o (option i32) c bool) i32
  effects: (write)
  (let-else (option.some v) (see) (return 0i32))
  v)

(defn within-fallback (o (option i32) c bool) i32
  effects: (write)
  (let-else (option.some v) o (do (see) (return 0i32)))
  v)

(defn within-return (o (option i32) c bool) i32
  effects: (write)
  (let - (if c (return (do (see) 1i32)) 2i32))
  0i32)

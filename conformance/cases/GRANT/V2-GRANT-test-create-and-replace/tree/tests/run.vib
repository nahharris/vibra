use @std.assert enduse

use @std.test.TestWorld enduse

use @std.fs.DirReadText enduse

use @std.fs.DirWriteText enduse

use @std.fs.RelativePath enduse

test "replace"
  takes {world: TestWorld}
  performs {TestWorld DirReadText DirWriteText}
  do
    let Result.ok(value: note) be RelativePath(["n.txt"]) endlet
    let {readText: reader writeText: writer} be await TestWorld.directory(world) endlet
    assert.equal(Result.ok(value: void) await DirWriteText.write(writer note "one"))
    assert.equal(Result.ok(value: void) await DirWriteText.write(writer note "two"))
    assert.equal(Result.ok(value: "two") await DirReadText.read(reader note))
endtest

use @std.assert enduse

use @std.test.TestWorld enduse

use @std.fs.DirList enduse

use @std.fs.DirWriteText enduse

use @std.fs.RelativePath enduse

test "sorted"
  takes {world: TestWorld}
  performs {TestWorld DirList DirWriteText}
  do
    let Result.ok(value: last) be RelativePath(["z.txt"]) endlet
    let Result.ok(value: first) be RelativePath(["a.txt"]) endlet
    let Result.ok(value: root) be RelativePath([]) endlet
    let {list: lister writeText: writer} be await TestWorld.directory(world) endlet
    assert.equal(Result.ok(value: void) await DirWriteText.write(writer last "z"))
    assert.equal(Result.ok(value: void) await DirWriteText.write(writer first "a"))
    assert.equal(Result.ok(value: ["a.txt" "z.txt"]) await DirList.entries(lister root))
endtest

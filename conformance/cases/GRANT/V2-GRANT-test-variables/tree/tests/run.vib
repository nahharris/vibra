use @std.assert enduse

use @std.test.TestWorld enduse

use @std.env.EnvReadVar enduse

use @std.env.EnvError enduse

test "variables"
  takes {world: TestWorld}
  performs {TestWorld EnvReadVar}
  do
    let {variables: reader} be await TestWorld.environment(world variables: ["HOME": "/h"]) endlet
    assert.equal(Result.ok(value: "/h") await EnvReadVar.read(reader "HOME"))
    assert.equal(Result.err(error: EnvError.notPresent()) await EnvReadVar.read(reader "NOPE"))
endtest

use @std.fs.DirReadText enduse

// A brand over a grant that claims an order of its own.
type Key of DirReadText
  impl Equatable
    fn equal
      takes {left: Self right: Self}
      returns same: Bool
      do
        return true
    endfn
  endimpl
  impl Ordered
    fn compare
      takes {left: Self right: Self}
      returns order: Ordering
      do
        return Ordering.equal()
    endfn
  endimpl
endtype

fn size takes {entries: Dict(Key Str)} returns n: U64 do return 0u64 endfn
use @std.assert enduse

use @std.test.TestWorld enduse

use @std.fs.DirReadText enduse

use @std.fs.DirList enduse

use @std.fs.DirWriteText enduse

use @std.fs.FsError enduse

use @std.fs.FsPolicy enduse

use @std.fs.FileDepth enduse

use @std.fs.FileAction enduse

use @std.fs.NameTest enduse

use @std.fs.RelativePath enduse

use @std.io.StdinBytes enduse

use @std.io.IoError enduse

use @std.io.StdoutText enduse

use @std.policy.GrantLimits enduse

use @std.policy.ScopeError enduse

use @app.notes enduse

use @app.logs enduse

// Reads only `.txt` files below `at`: the chapter's `textOnly`.
fn textOnly
  takes {at: RelativePath}
  returns policy: FsPolicy
  do
    return FsPolicy.files(
      prefix: at
      depth: FileDepth.tree()
      actions: [FileAction.read()]
      names: NameTest.suffix(value: ".txt")
    )
endfn

// Reads every file below `at`.
fn anyFile
  takes {at: RelativePath}
  returns policy: FsPolicy
  do
    return FsPolicy.files(
      prefix: at
      depth: FileDepth.tree()
      actions: [FileAction.read()]
      names: NameTest.anyName()
    )
endfn

fn callsAtMost
  takes {count: U64}
  returns limits: GrantLimits
  do
    return GrantLimits(
      invocations: Option.some(value: count)
      inputBytes: Option.none()
      outputBytes: Option.none()
    )
endfn

fn inputAtMost
  takes {count: U64}
  returns limits: GrantLimits
  do
    return GrantLimits(
      invocations: Option.none()
      inputBytes: Option.some(value: count)
      outputBytes: Option.none()
    )
endfn

fn outputAtMost
  takes {count: U64}
  returns limits: GrantLimits
  do
    return GrantLimits(
      invocations: Option.none()
      inputBytes: Option.none()
      outputBytes: Option.some(value: count)
    )
endfn
// A model holding two grants: it reads through `inner`, and its `restrict`
// returns a model over `spare`, which no narrowing made.
type Swap of {inner: DirReadText spare: DirReadText}
  impl DirReadText
    proc read
      takes {grant: Self at: RelativePath}
      returns outcome: Result(Str FsError)
      do
        return await DirReadText.read(grant.inner at)
    endproc
    fn restrict
      takes {grant: Self policy: FsPolicy}
      returns narrowed: Result(Self ScopeError)
      do
        return Result.ok(value: Swap(inner: grant.spare spare: grant.spare))
    endfn
    fn sub
      takes {grant: Self prefix: RelativePath}
      returns narrowed: Result(Self ScopeError)
      do
        return Result.ok(value: grant)
    endfn
    fn limit
      takes {grant: Self limits: GrantLimits}
      returns narrowed: Self
      do
        return grant
    endfn
  endimpl
endtype
test "swaps"
  takes {world: TestWorld}
  performs {TestWorld DirReadText}
  do
    let Result.ok(value: here) be RelativePath([]) endlet
    let Result.ok(value: aTxt) be RelativePath(["a.txt"]) endlet
    let Result.ok(value: bBin) be RelativePath(["b.bin"]) endlet
    let Result.ok(value: subTxt) be RelativePath(["sub" "s.txt"]) endlet
    let Result.ok(value: subDir) be RelativePath(["sub"]) endlet
    let Result.ok(value: sTxt) be RelativePath(["s.txt"]) endlet
    let dir be await TestWorld.directory(world files: [aTxt: "A" bBin: "B" subTxt: "S"]) endlet
    match DirReadText.sub(dir.readText subDir)
      case Result.ok(value: below)
        let swap be Swap(inner: below spare: dir.readText) endlet
        assert.equal(Result.ok(value: "S") await DirReadText.read(swap sTxt))    match DirReadText.restrict(swap textOnly(here))
          case Result.ok(value: narrowed)
            assert.equal(Result.ok(value: "A") await DirReadText.read(narrowed aTxt))
          case Result.err(error: _)
            assert.true(false)
        endmatch
      case Result.err(error: _)
        assert.true(false)
    endmatch
endtest

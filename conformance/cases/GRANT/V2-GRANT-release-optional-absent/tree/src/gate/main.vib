// The release program: counts the lines of the `.txt` notes in the directory
// its one argument names, shows the counts, writes a log under the log
// directory, and writes the mean to the metric directory when
// `GATE_METRICS` names one.

use @std.env.EnvReadArgs enduse

use @std.env.EnvReadVar enduse

use @std.fs.DirList enduse

use @std.fs.DirReadText enduse

use @std.fs.DirWriteText enduse

use @std.fs.FsError enduse

use @std.fs.RelativePath enduse

use @std.io.StdoutText enduse

use @std.process.ExitCode enduse

use @gatePure.metric enduse

use @gate.tally enduse

proc main
  takes {
    args: EnvReadArgs
    vars: EnvReadVar
    notes: {list: DirList reader: DirReadText}
    logs: DirWriteText
    metrics: Option(DirWriteText)
    out: StdoutText
  }
  returns code: ExitCode
  performs {EnvReadArgs DirList DirReadText DirWriteText StdoutText}
  visibility @public
  do
    let Result.ok(value: arguments) be await EnvReadArgs.read(args) else
      return ExitCode(1u8)
    endlet
    if Bool.not(Equatable.equal(List.length(arguments) 1u64)) then
      let _ be await StdoutText.write(out "usage: gate <notes directory>\n") endlet
      return ExitCode(2u8)
    endif
    let {list: list reader: reader} be notes endlet
    let Result.ok(value: names) be await tally.listNotes(list) else
      let _ be await StdoutText.write(out "the notes directory cannot be listed\n")
      endlet
      return ExitCode(1u8)
    endlet
    let empty be tally.Tally(counts: [] shown: "" logged: "") endlet
    let found be await tally.readNotes(reader names empty) endlet
    let tally.Tally(counts: counts shown: shown logged: _) be found endlet
    let summary be metric.summarize(counts) endlet
    let total be Str.concat(metric.render(summary) "\n") endlet
    let _ be await StdoutText.write(out Str.concat(shown total)) endlet
    let metricLine be await report(metrics summary) endlet
    let writeLog be
      proc
        takes {text: Str}
        returns outcome: Result(Void FsError)
        performs {DirWriteText}
        do
          let Result.ok(value: at) be RelativePath(["gate.log"]) endlet
          return await DirWriteText.write(logs at text)
      endproc
    endlet
    let Result.ok(value: _) be
      await tally.record(found summary metricLine writeLog) else
      return ExitCode(1u8)
    endlet
    return ExitCode(0u8)
endproc

// Writes the mean of `summary` to `gate.metric` in the metric directory, if
// there is one, and returns the log's line about it.
proc report
  takes {metrics: Option(DirWriteText) summary: metric.Summary}
  returns logged: Str
  performs {DirWriteText}
  do
    let Option.some(value: directory) be metrics else return "metric: absent\n" endlet
    let Result.ok(value: at) be RelativePath(["gate.metric"]) endlet
    let outcome be await DirWriteText.write(directory at meanText(summary)) endlet
    match outcome
      case Result.ok(value: _)
        return "metric: gate.metric\n"
      case Result.err(error: error)
        return tally.line("" "metric" tally.describe(error))
    endmatch
endproc

// The metric file's text: the mean number of lines per note.
fn meanText
  takes {summary: metric.Summary}
  returns text: Str
  do
    let Option.some(value: mean) be metric.meanLines(summary) else
      return "no notes\n"
    endlet
    return Str.concat("mean lines per note: " Str.concat(From.convert(mean) "\n"))
endfn

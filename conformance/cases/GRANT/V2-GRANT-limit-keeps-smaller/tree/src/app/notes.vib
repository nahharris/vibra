use @std.fs.DirReadText enduse

use @std.fs.DirWriteText enduse

use @std.fs.FsError enduse

use @std.fs.FsPolicy enduse

use @std.fs.RelativePath enduse

use @std.io.StdoutText enduse

use @std.policy.GrantLimits enduse

use @std.policy.ScopeError enduse

fn newlines
  takes {text: Str}
  returns count: U64
  do
    let Option.some(value: {first rest}) be Iter.next(text) else
      return 0u64
    endlet
    match first
      case '\n'
        return U64.add(1u64 newlines(rest))
      case _
        return newlines(rest)
    endmatch
endfn

proc countLines
  takes {reader: DirReadText path: RelativePath}
  returns count: Result(U64 FsError)
  performs {DirReadText}
  visibility @public
  do
    let text be try await DirReadText.read(reader path) endlet
    return Result.ok(value: U64.add(1u64 newlines(text)))
endproc

// Reads one file through whatever `reader` holds.
proc readNote
  takes {reader: DirReadText at: RelativePath}
  returns text: Result(Str FsError)
  performs {DirReadText}
  visibility @public
  do
    return await DirReadText.read(reader at)
endproc

// The chapter's three shapes: a required grant, an optional one, a bundle.
proc report
  takes {
    notes: DirReadText
    metrics: Option(StdoutText)
    logs: {reader: DirReadText writer: DirWriteText}
    at: RelativePath
    log: RelativePath
  }
  returns outcome: Result(Str FsError)
  performs {DirReadText DirWriteText StdoutText}
  visibility @public
  do
    let text be try await DirReadText.read(notes at) endlet
    match metrics
      case Option.some(value: sender)
        let _ be await StdoutText.write(sender text) endlet
      case Option.none()
        let _ be text endlet
    endmatch
    let _ be try await DirWriteText.write(logs.writer log text) endlet
    return await DirReadText.read(logs.reader log)
endproc

// Views any implementation as a `DirReadText`.
fn view
  takes {reader: DirReadText}
  returns same: DirReadText
  visibility @public
  do
    return reader
endfn

// A memory-only model holding one text, whose narrowing members return it.
type Memory of {text: Str}
  visibility @public
  impl DirReadText
    proc read
      takes {grant: Self at: RelativePath}
      returns outcome: Result(Str FsError)
      do
        return Result.ok(value: grant.text)
    endproc
    fn restrict
      takes {grant: Self policy: FsPolicy}
      returns narrowed: Result(Self ScopeError)
      do
        return Result.ok(value: grant)
    endfn
    fn sub
      takes {grant: Self prefix: RelativePath}
      returns narrowed: Result(Self ScopeError)
      do
        return Result.ok(value: grant)
    endfn
    fn limit
      takes {grant: Self limits: GrantLimits}
      returns narrowed: Self
      do
        return grant
    endfn
  endimpl
endtype

// A grant-backed model: it reads through the grant it holds and forwards
// each narrowing to it.
type Forward of {inner: DirReadText}
  visibility @public
  impl DirReadText
    proc read
      takes {grant: Self at: RelativePath}
      returns outcome: Result(Str FsError)
      do
        return await DirReadText.read(grant.inner at)
    endproc
    fn restrict
      takes {grant: Self policy: FsPolicy}
      returns narrowed: Result(Self ScopeError)
      do
        let inner be try DirReadText.restrict(grant.inner policy) endlet
        return Result.ok(value: Forward(inner: inner))
    endfn
    fn sub
      takes {grant: Self prefix: RelativePath}
      returns narrowed: Result(Self ScopeError)
      do
        let inner be try DirReadText.sub(grant.inner prefix) endlet
        return Result.ok(value: Forward(inner: inner))
    endfn
    fn limit
      takes {grant: Self limits: GrantLimits}
      returns narrowed: Self
      do
        return Forward(inner: DirReadText.limit(grant.inner limits))
    endfn
  endimpl
endtype
use @std.assert enduse

use @std.test.TestWorld enduse

use @std.time.WallClock enduse

use @std.random.RandomBytes enduse

use @std.env.EnvReadArgs enduse

test "default"
  takes {world: TestWorld}
  performs {TestWorld WallClock RandomBytes EnvReadArgs}
  do
    let {wall: wall} be await TestWorld.clocks(world) endlet
    let random be await TestWorld.random(world) endlet
    let {arguments: reader} be await TestWorld.environment(world) endlet
    assert.equal(Result.ok(value: 0i64) await WallClock.read(wall))
    assert.equal(Result.ok(value: Bytes([175u8])) await RandomBytes.generate(random 1u64))
    assert.equal(Result.ok(value: []) await EnvReadArgs.read(reader))
endtest

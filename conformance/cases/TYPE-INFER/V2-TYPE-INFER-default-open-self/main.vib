interface Pick
  fn pick takes {value: Self} labelled {other: Option(Self) be Option.none()} returns r: I32 do match other case Option.none() return 1i32 case Option.some(value: v) return 2i32 endmatch endfn
endinterface
type A of I32
  impl Pick endimpl
endtype
fn main returns r: I32 do return Pick.pick(A(1i32)) endfn

interface Bag
  type Item endtype
  fn count takes {value: Self} labelled {items: List(Item) be []} returns r: I32 endfn
endinterface
type A of I32
  impl Bag type Item of U8 endtype fn count takes {value: Self} labelled {items: List(U8) be []} returns r: I32 do return 6i32 endfn endimpl
endtype
fn main returns r: I32 do return Bag.count(A(1i32)) endfn

(import assert @std.assert)
(import shapes @geo.shapes)

(test "dispatches a written member from an imported interface"
  (assert.equal (shapes.shape.name (shapes.square side: 2i32)) "square"))

(test "calls the default member"
  (assert.equal (shapes.shape.label (shapes.circle radius: 1i32)) "shape"))

(test "dispatches through bounded generics"
  (assert.equal
    (shapes.sides-of (shapes.square side: 1i32) (shapes.circle radius: 1i32))
    (tupleof 4i32 0i32)))

(test "widens to an imported interface value and dispatches through it"
  (assert.equal (shapes.name-of (shapes.circle radius: 2i32)) "circle"))

(test "names an imported interface in type position"
  (let held (as shapes.shape (shapes.square side: 1i32))
    (assert.equal (shapes.shape.name held) "square")))

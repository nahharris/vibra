interface Log
  proc append
    takes {log: Self entry: Str}
    returns done: Void
  endproc
endinterface

interface Clock
  proc now takes {clock: Self} returns at: I64 endproc
endinterface

interface Shown
  fn show takes {value: Self} returns text: Str endfn
endinterface
interface Both proc go takes {b: Self} returns d: Void endproc fn name takes {b: Self} returns n: Str endfn endinterface
fn label(T) takes {b: T} returns n: Str given {T: Both} do return Both.name(b) endfn

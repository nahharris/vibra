interface Log
  proc append
    takes {log: Self entry: Str}
    returns done: Void
  endproc
endinterface

interface Clock
  proc now takes {clock: Self} returns at: I64 endproc
endinterface

interface Shown
  fn show takes {value: Self} returns text: Str endfn
endinterface

type Memory of {lines: List(Str)}
  impl Log
    proc append takes {log: Self entry: Str} returns done: Void do
      return void
    endproc
  endimpl
  impl Clock
    proc now takes {clock: Self} returns at: I64 do return 0i64 endproc
  endimpl
endtype

proc note takes {m: Memory} returns done: Void performs {Log} do
  return await Log.append(m "x")
endproc
proc bad takes {m: Memory} returns d: Void do let _ be await Log.append(m "a") endlet return await Log.append(m "b") endproc

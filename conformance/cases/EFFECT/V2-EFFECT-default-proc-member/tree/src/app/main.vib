interface Log
  proc append
    takes {log: Self entry: Str}
    returns done: Void
  endproc
  proc appendTwice takes {log: Self entry: Str} returns done: Void do let _ be Log.append(log entry) endlet return void endproc
endinterface

interface Clock
  proc now takes {clock: Self} returns at: I64 endproc
endinterface

interface Shown
  fn show takes {value: Self} returns text: Str endfn
endinterface

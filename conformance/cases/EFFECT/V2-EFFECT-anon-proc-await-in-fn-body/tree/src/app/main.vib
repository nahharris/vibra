interface Log
  proc append
    takes {log: Self entry: Str}
    returns done: Void
  endproc
endinterface

interface Clock
  proc now takes {clock: Self} returns at: I64 endproc
endinterface

interface Shown
  fn show takes {value: Self} returns text: Str endfn
endinterface

type Memory of {lines: List(Str)}
  impl Log
    proc append takes {log: Self entry: Str} returns done: Void do
      return void
    endproc
  endimpl
  impl Clock
    proc now takes {clock: Self} returns at: I64 do return 0i64 endproc
  endimpl
endtype

proc note takes {m: Memory} returns done: Void performs {Log} do
  return await Log.append(m "x")
endproc
proc run takes {m: Memory} returns r: I32 do let s be proc returns d: I32 do let f be fn returns e: Void do return await Log.append(m "x") endfn endlet return 1i32 endproc endlet return 1i32 endproc

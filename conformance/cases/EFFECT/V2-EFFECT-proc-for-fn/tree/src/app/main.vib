interface Log
  proc append
    takes {log: Self entry: Str}
    returns done: Void
  endproc
endinterface

interface Clock
  proc now takes {clock: Self} returns at: I64 endproc
endinterface

interface Shown
  fn show takes {value: Self} returns text: Str endfn
endinterface

type Memory of {lines: List(Str)}
  impl Log
    proc append takes {log: Self entry: Str} returns done: Void do
      return void
    endproc
  endimpl
  impl Clock
    proc now takes {clock: Self} returns at: I64 do return 0i64 endproc
  endimpl
endtype

proc note takes {m: Memory} returns done: Void performs {Log} do
  return await Log.append(m "x")
endproc
proc double takes {n: I32} returns twice: I32 do return I32.add(n n) endproc
fn call takes {f: Fn({I32} I32)} returns r: I32 do return f(1i32) endfn
fn run returns r: I32 do return call(double) endfn

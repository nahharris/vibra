interface Log
  proc append
    takes {log: Self entry: Str}
    returns done: Void
  endproc
endinterface

interface Clock
  proc now takes {clock: Self} returns at: I64 endproc
endinterface

interface Shown
  fn show takes {value: Self} returns text: Str endfn
endinterface
type Memory of {lines: List(Str)} impl Log fn append takes {log: Self entry: Str} returns done: Void do return void endfn endimpl endtype

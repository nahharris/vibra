(defn flip (low bool bit bool) bool (if low (if bit false true) bit))

(defn count
  (finish
    (fn () str)
    b0
    bool
    b1
    bool
    b2
    bool
    b3
    bool
    b4
    bool
    b5
    bool
    b6

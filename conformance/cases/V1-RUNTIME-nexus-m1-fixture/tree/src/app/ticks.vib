; The counting loop of the Nexus M1 fixture. The counter is held in 17 bool
; parameters and counts down in binary with only `if`: a bit flips when every
; lower bit is clear, and the counter is zero when every bit is clear. When it
; reaches zero the loop makes an indirect tail call of `finish`, a function value
; that the other module defined.
(defn clear-1 (b0 bool) bool (if b0 false true))

(defn clear-2 (b0 bool b1 bool) bool (if (clear-1 b0) (if b1 false true) false))

(defn clear-3 (b0 bool b1 bool b2 bool) bool
  (if (clear-2 b0 b1) (if b2 false true) false))

(defn clear-4 (b0 bool b1 bool b2 bool b3 bool) bool
  (if (clear-3 b0 b1 b2) (if b3 false true) false))

(defn clear-5 (b0 bool b1 bool b2 bool b3 bool b4 bool) bool
  (if (clear-4 b0 b1 b2 b3) (if b4 false true) false))

(defn clear-6 (b0 bool b1 bool b2 bool b3 bool b4 bool b5 bool) bool
  (if (clear-5 b0 b1 b2 b3 b4) (if b5 false true) false))

(defn clear-7 (b0 bool b1 bool b2 bool b3 bool b4 bool b5 bool b6 bool) bool
  (if (clear-6 b0 b1 b2 b3 b4 b5) (if b6 false true) false))

(defn clear-8 (b0 bool b1 bool b2 bool b3 bool b4 bool b5 bool b6 bool b7 bool) bool
  (if (clear-7 b0 b1 b2 b3 b4 b5 b6) (if b7 false true) false))

(defn clear-9 (b0 bool b1 bool b2 bool b3 bool b4 bool b5 bool b6 bool b7 bool b8 bool)
  bool
  (if (clear-8 b0 b1 b2 b3 b4 b5 b6 b7) (if b8 false true) false))

(defn clear-10
  (b0 bool b1 bool b2 bool b3 bool b4 bool b5 bool b6 bool b7 bool b8 bool b9 bool)
  bool
  (if (clear-9 b0 b1 b2 b3 b4 b5 b6 b7 b8) (if b9 false true) false))


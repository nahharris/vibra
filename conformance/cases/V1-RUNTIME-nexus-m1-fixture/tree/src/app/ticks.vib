    b11
    bool
    b12
    bool
    b13
    bool
    b14
    bool
    b15
    bool
    b16
    bool)
  str
  visibility: @public
  (if
    (clear-17 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15 b16)
    (finish)
    (count
      finish
      (if b0 false true)
      (flip (clear-1 b0) b1)
      (flip (clear-2 b0 b1) b2)
      (flip (clear-3 b0 b1 b2) b3)
      (flip (clear-4 b0 b1 b2 b3) b4)
      (flip (clear-5 b0 b1 b2 b3 b4) b5)
      (flip (clear-6 b0 b1 b2 b3 b4 b5) b6)
      (flip (clear-7 b0 b1 b2 b3 b4 b5 b6) b7)
      (flip (clear-8 b0 b1 b2 b3 b4 b5 b6 b7) b8)
      (flip (clear-9 b0 b1 b2 b3 b4 b5 b6 b7 b8) b9)
      (flip (clear-10 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9) b10)
      (flip (clear-11 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10) b11)
      (flip (clear-12 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11) b12)
      (flip (clear-13 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12) b13)
      (flip (clear-14 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13) b14)
      (flip (clear-15 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14) b15)
      (flip (clear-16 b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11 b12 b13 b14 b15) b16))))

fn main returns r: Void do return Walk.go(Seed(0u8) 1u8) endfn

interface Walk
  fn go(T)
    takes {x: Self item: T}
    returns r: Void
  endfn
endinterface

type Seed of U8
  impl Walk
    fn go(T)
      takes {x: Self item: T}
      returns r: Void
      do
        let w: Walk be x endlet
        return Walk.go(w [item])
    endfn
  endimpl
endtype

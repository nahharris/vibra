fn main returns r: Str do return show(User(name: "Ada" id: UserId(1u64))) endfn

fn show(T)
  takes {v: T}
  returns r: Str
  given {T: Printable}
  do
    return Printable.render(v)
endfn
interface Printable
  fn render
    takes {value: Self}
    returns text: Str
  endfn
endinterface
type UserId of U64 endtype

type User of {name: Str id: UserId}
  impl Printable
    fn render
      takes {value: Self}
      returns text: Str
      do
        let User(name: name id: _) be value endlet
        return name
    endfn
  endimpl
endtype
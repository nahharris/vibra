interface Feed(S)
  given {S: Ordered}
  fn feed
    takes {x: Self item: S}
    returns r: U8
  endfn
endinterface

type Plain of U8 endtype
type Box of U8
  impl Feed(U8)
    fn feed takes {x: Self item: U8} returns r: U8 do return item endfn
  endimpl
endtype

fn viaValue takes {v: Feed(U8)} returns r: U8 do return Feed.feed(v 1u8) endfn

fn viaBound(T U) takes {x: T u: U} returns r: U8 given {U: Ordered T: Feed(U)} do return 0u8 endfn

fn main returns r: U8 do return U8.add(viaValue(Box(0u8)) viaBound(Box(0u8) 1u8)) endfn

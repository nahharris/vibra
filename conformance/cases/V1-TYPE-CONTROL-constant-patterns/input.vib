(deftype color (enum red void green void))
(def limit i32 10i32)
(def top i32 limit)
(def favorite color (color.green))
(def origin (tuple i32 i32) (tupleof 0i32 0i32))

(defn by-limit (n i32) str
  (match n limit "limit" - "other"))

(defn by-top (n i32) str
  (match n top "top" - "other"))

(defn by-color (value color) str
  (match value favorite "favorite" - "other"))

(defn by-origin (point (tuple i32 i32)) str
  (match point origin "origin" - "elsewhere"))

(defn by-flag (flag bool) str
  (match flag true "yes" false "no"))

(defn by-constructor (flag bool) str
  (match flag (bool.true) "yes" (bool.false) "no"))

(defn by-pair (pair (tuple i32 bool)) str
  (match pair (tupleof - true) "on" (tupleof - false) "off"))

(defn by-let (flag bool) str
  (let-else true flag (return "off"))
  "on")

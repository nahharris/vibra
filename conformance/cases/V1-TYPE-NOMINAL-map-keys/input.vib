(deftype user (record name str))

(defn floats (m (map f64 i32)) i32 0i32)

(defn voids (m (map void i32)) i32 0i32)

(defn arrays (m (map (array i32) i32)) i32 0i32)

(defn users (m (map user i32)) i32 0i32)

(defn functions (m (map (fn () i32) i32)) i32 0i32)

(defn inferred () i32 (let m (map.of 1.0f64 2i32) 0i32))

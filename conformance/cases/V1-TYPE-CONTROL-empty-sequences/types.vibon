(record
  format: @types.v1
  globals: (array
    (record name: @true type: @bool body: (record kind: @variant type: @bool variant: @true))
    (record name: @false type: @bool body: (record kind: @variant type: @bool variant: @false))
  )
  functions: (array
    (record name: @empty params: (array) result: @void body: (record kind: @sequence type: @void values: (array (record kind: @literal type: @void value: void))))
    (record name: @let-empty params: (array) result: @void body: (record kind: @sequence type: @void values: (array (record kind: @let slot: void value: (record kind: @literal type: @i32 value: 1i32) body: (record kind: @sequence type: @void values: (array (record kind: @literal type: @void value: void)))))))
  )
)

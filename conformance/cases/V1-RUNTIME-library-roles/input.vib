(defn main () (tuple bool bool str (array char) bytes u64 i32 str bool)
  (tupleof
    (bool.true)
    (match false (bool.false) true (bool.true) false)
    (str (array.of \h \i))
    (let (str scalars) "héllo" scalars)
    (bytes (array.of 104u8 105u8))
    (let (bytes items) (bytes (array.of 1u8 2u8 3u8)) (array.length items))
    (array.fold
      (array.of 1i32 2i32 3i32)
      10i32
      (lambda (total i32 item i32) i32
        (match (i32.sub-checked total item) (result.ok difference) difference - 0i32)))
    (match "hi" (str (array)) "empty" (str (array first -)) "pair" - "other")
    (match "ab" "ab" true (str -) false)))

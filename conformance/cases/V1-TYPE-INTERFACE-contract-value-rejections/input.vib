(defn no-written-type () i32
  (let picked mapper.map-to)
  0i32)

(defn no-written-type-labelled () i32
  (let chosen scaler.scale)
  0i32)

(defn unsatisfied-receiver () (fn (str (fn (str) i32)) (array i32))
  mapper.map-to)

(defn wrong-shape () (fn (box (fn (box) i32)) (array str))
  mapper.map-to)

(defn wrong-labelled-type () (fn (gauge) (tuple i32 i32) labelled: (by str offset i32))
  scaler.scale)

(defn wrong-labels () (fn (gauge) (tuple i32 i32) labelled: (step i32))
  scaler.scale)

(defn generic-left-open () (fn (holder) str)
  probing.probe)

(defn two-fit () (fn (both bool) bool)
  noted.note)

(defn none-fits () (fn (both bool) str)
  noted.note)

(defn valid-generic () (fn (box (fn (box) str)) (array str))
  mapper.map-to)

(defn valid-labelled () (fn (gauge) (tuple i32 i32) labelled: (by i32 offset i32))
  scaler.scale)

(defn valid-dict-tail () (fn (gauge) (dict str i32) variadic: (dict str i32))
  collector.collect)

(defint mapper
  (defn map-to (value self f (fn (self) u)) (array u)
    where: (u any)))

(defint scaler
  (defn scale (value self) (tuple i32 i32)
    labelled: (by i32 2i32 offset i32 0i32)))

(defint collector
  (defn collect (value self) (dict str i32)
    variadic: (entries (dict str i32))))

(defint maker
  (defn make () self))

(defint probing
  (defn probe (value self) str
    where: (u maker)))

(defint noted
  where: (t any)
  (defn note (value self other u) u
    where: (u any)))

(deftype box (record n i32)
  (impl mapper
    (defn map-to (value self f (fn (self) u)) (array u)
      where: (u any)
      (array.of (f value)))))

(deftype gauge (record base i32)
  (impl scaler
    (defn scale (value self) (tuple i32 i32)
      labelled: (by i32 2i32 offset i32 0i32)
      (tupleof by offset)))
  (impl collector
    (defn collect (value self) (dict str i32)
      variadic: (entries (dict str i32))
      entries)))

(deftype holder i32
  (impl probing
    (defn probe (value self) str
      where: (u maker)
      "held")))

(deftype both (record n i32)
  (impl (noted str)
    (defn note (value self other u) u
      where: (u any)
      other))
  (impl (noted i64)
    (defn note (value self other u) u
      where: (u any)
      other)))

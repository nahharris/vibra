(deftype mixed (enum a never b i32 c i32))

(defn only-ok (r (result i32 never)) i32 (match r (result.ok v) v))

(defn err-arm (r (result i32 never)) i32
  (match r
    (result.ok v) v
    (result.err e) 0i32))

(defn skips-variant (m mixed) i32 (match m (mixed.b x) x))

(defn let-ok (r (result i32 never)) i32 (let (result.ok value) r) value)

(defn uninhabited-scrutinee (t (tuple i32 never)) i32 (match t - 0i32))

(defn uninhabited-let (t (tuple i32 never)) i32 (let - t) 0i32)
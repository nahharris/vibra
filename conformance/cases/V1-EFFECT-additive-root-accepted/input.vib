(deffect write
  (defn text (target str event str) void (do)))

(deffect audit
  (defn record (target str event str) void
    effects: (write)
    (write.text target event)))

(defn handle-request (target str summary str) void
  effects: (audit write)
  (audit.record target summary))

(defn caller (target str) void
  effects: (audit write)
  (handle-request target "done"))

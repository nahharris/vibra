(import assert @std.assert)
(import core @std.core)

(test "char scalars"
  (assert.true (equatable.equal (char.to-u32 \u03A9) 937u32)))

(test "a surrogate is no char"
  (assert.true (match (char.from-u32 55296u32) (option.none) true - false)))

(test "text equality and order"
  (assert.true
    (match (ordered.compare "ab" "b")
      (core.ordering.less) (equatable.equal "é" "é")
      - false)))

(test "text slices count scalars"
  (assert.equal
    (match (str.slice "héllo" 1u64 3u64) (option.some part) part - "")
    "él"))

(test "an out-of-range text slice is none"
  (assert.true (match (str.slice "abc" 2u64 1u64) (option.none) true - false)))

(test "text and chars round-trip"
  (let (str scalars) "Ωmega")
  (assert.equal (str scalars) "Ωmega"))

(test "utf-8 encodes scalars"
  (assert.equal (bytes.length (str.to-utf8 "é")) 2u64))

(test "ill-formed utf-8 is invalid"
  (assert.true
    (match (str.from-utf8 (bytes (array.of 255u8)))
      (result.err (core.conversion-error.invalid-format)) true
      - false)))

(test "bytes concatenate, compare, and slice"
  (let joined (bytes.concat (str.to-utf8 "ab") (str.to-utf8 "c")))
  (assert.true
    (match (bytes.slice joined 1u64 3u64)
      (option.some part)
        (match (ordered.compare part (str.to-utf8 "bc"))
          (core.ordering.equal) (equatable.equal part (str.to-utf8 "bc"))
          - false)
      - false)))

(test "bytes as an array"
  (let (bytes items) (str.to-utf8 "hey"))
  (assert.equal (array.length items) 3u64))

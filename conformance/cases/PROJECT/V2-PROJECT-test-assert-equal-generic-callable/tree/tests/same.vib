use @std.assert enduse

// Asserts through `assert.equal`, generic over any `Encodable` type.
fn same(T)
  takes {expected: T actual: T}
  returns done: Void
  given {T: Encodable}
  do
    assert.equal(expected actual)
    return void
endfn

fn one takes {} returns r: I32 do return 1i32 endfn

test "functions" do same(one one) endtest

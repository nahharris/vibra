    (record name: "@tests.console::\"each test starts from a fresh world\"" result: @test.passed audit-trace: (record format: @audit-trace.v1 events: (array (record kind: @host op: "io.stdin-text" args: (array) result: (record kind: @enum type: @std.result.result variant: @ok payload: "from the world")))))
  )

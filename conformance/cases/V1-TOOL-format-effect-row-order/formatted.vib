(defn main () void (do))

(deffect write (defn text (target str) void (do)))

(deffect audit (defn record (target str) void effects: (write) (write.text target)))

(deffect zebra (defn stripe () void (do)))

(defn both (target str) void
  effects: (audit write zebra)
  (audit.record target)
  (zebra.stripe))

(defn accept (callback (fn (str) void effects: (audit write)) target str) void
  effects: (audit write)
  (callback target))

(import fs @std.fs)
(import text @std.text)

(defn main () (result void fs.fs-error)
  effects: (fs.read fs.write)
  (let target (fs.path "/out/log.txt"))
  (let - (try (fs.write.text target "one")))
  (let - (try (fs.read.text target)))
  (let - (try (fs.write.text target "two é")))
  (let - (try (fs.read.text target)))
  (let - (try (fs.write.file target (text.to-utf8 "three"))))
  (let - (try (fs.read.file target)))
  (let - (try (fs.write.text (fs.path "/out/new.txt") "")))
  (let - (try (fs.read.entries (fs.path "/out"))))
  (result.ok))

    (record name: "@tests.shapes::\"destructures in let\"" result: @test.passed audit-trace: (record format: @audit-trace.v1 events: (array)))
    (record name: "@tests.shapes::\"matches a void variant\"" result: @test.passed audit-trace: (record format: @audit-trace.v1 events: (array)))
  )
)

(import assert @std.assert)
(import shapes @geo.shapes)

(test "constructs and projects"
  (assert.equal ((shapes.point x: 1i32 y: 2i32) @y) 2i32))

(test "calls a method by path"
  (assert.equal ((shapes.point.flip (shapes.point x: 1i32 y: 2i32)) @x) 2i32))

(test "reads an imported value"
  (assert.equal ((shapes.origin) @x) 0i32))

(test "builds a variant"
  (let - (shapes.size.large 3u64))
  (assert.true true))

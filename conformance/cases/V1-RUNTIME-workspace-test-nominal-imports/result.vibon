    (record name: "@tests.shapes::\"reads an imported value\"" result: @test.passed audit-trace: (record format: @audit-trace.v1 events: (array)))
    (record name: "@tests.shapes::\"builds a variant\"" result: @test.passed audit-trace: (record format: @audit-trace.v1 events: (array)))
  )
)

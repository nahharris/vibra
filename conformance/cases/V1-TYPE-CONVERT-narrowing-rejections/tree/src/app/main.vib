(deftype number (union i32 f32))

(defn non-union (value i32) i32 (match value (as i32 n) n))

(defn non-member (value number) i32 (match value (as str -) 0i32 - 1i32))

(defn in-let (value number) i32 (let (as i32 n) value) n)

(defn in-parameter ((as i32 n) number) i32 n)

(defn missing (value number) i32 (match value (as i32 n) n))

(defn repeated (value number) i32
  (match value (as i32 n) n (as f32 -) 0i32 (as i32 -) 1i32))

fn main returns r: {I32 I32} do return {apply(1i32) apply(1i32 f: dec)} endfn
fn inc takes {x: I32} returns r: I32 do return I32.add(x 1i32) endfn
fn dec takes {x: I32} returns r: I32 do return I32.sub(x 1i32) endfn
fn apply takes {v: I32} labelled {f: Fn({I32} I32) be inc} returns r: I32 do return f(v) endfn
fn main returns r: {I32 I32} do return {apply(1i32) apply(1i32 fs: [])} endfn
fn apply takes {v: I32} labelled {fs: List(Fn({I32} I32)) be [fn takes {x: I32} returns r: I32 do return I32.add(x 1i32) endfn fn takes {x: I32} returns r: I32 do return I32.mul(x 2i32) endfn]} returns r: I32 do
  match fs
    case [g h]
      return h(g(v))
    case _
      return v
  endmatch
endfn
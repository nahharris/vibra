(import core @std.core)

(import from @std.core.from)

(import try-from @std.core.try-from)

(defn main ()
  (tuple
    (result i32 core.arithmetic-error)
    (result i32 core.arithmetic-error)
    (result i8 core.arithmetic-error)
    (result i8 core.arithmetic-error)
    (result i16 core.arithmetic-error)
    (result u8 core.arithmetic-error)
    (result u32 core.arithmetic-error)
    (result i64 core.arithmetic-error)
    bool
    core.ordering
    str
    (result u16 core.conversion-error)
    (result i8 core.conversion-error)
    (result u64 core.conversion-error))
  (tupleof
    (i32.add 2147483646i32 1i32)
    (i32.add 2147483647i32 1i32)
    (i8.div -128i8 -1i8)
    (i8.rem -7i8 2i8)
    (i16.neg -32768i16)
    (u8.div 1u8 0u8)
    (u32.shift-left 1u32 32u32)
    (i64.shift-right -9i64 1u32)
    (equatable.equal 7u16 7u16)
    (ordered.compare -1i32 1i32)
    (from.convert -9223372036854775808i64)
    (try-from.convert "65535")
    (try-from.convert "-129")
    (try-from.convert "-1")))

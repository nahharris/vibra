(defn main () u64 (first 100000u64))

(defn first (count u64) u64
  (if (u64.equal count 0u64) (second 100000u64) (first (lower count))))

(defn second (count u64) u64
  (if (u64.equal count 0u64) (last 19u64) (second (lower count))))

(defn last (value u64) u64 value)

(defn lower (count u64) u64
  (match (u64.sub-checked count 1u64)
    (result.ok value) value
    (result.err -) 0u64))

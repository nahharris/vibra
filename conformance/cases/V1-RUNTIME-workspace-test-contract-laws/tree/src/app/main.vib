(import core @std.core)

(defn execute () void void)

; A version orders by `major`, then `minor`, and is equal when both are.
(deftype version (record major u8 minor u8)
  visibility: @public
  (impl equatable
    (defn equal (left self right self) bool
      (match (ordered.compare left right) (core.ordering.equal) true - false)))
  (impl ordered
    (defn compare (left self right self) core.ordering
      (match (ordered.compare (left @major) (right @major))
        (core.ordering.equal) (ordered.compare (left @minor) (right @minor))
        order order))))

(defn double (value i32) i32
  visibility: @public
  (match (i32.mul value 2i32) (result.ok twice) twice (result.err -) 0i32))

(defn odd (value i32) bool
  visibility: @public
  (match (i32.rem value 2i32)
    (result.ok remainder) (equatable.equal remainder 1i32)
    (result.err -) false))

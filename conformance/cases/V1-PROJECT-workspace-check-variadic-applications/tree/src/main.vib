(defn collect-array (first i32) i32
  variadic: (rest (array i32))
  first)
(defn use-array () i32
  (do (collect-array 1i32) (collect-array 1i32 2i32)))
(defn collect-dict (first i32) i32
  variadic: (rest (dict str i32))
  first)
(defn use-dict () i32
  (do (collect-dict 1i32) (collect-dict 1i32 "key" 2i32)))

interface Sized
  fn size
    takes {value: Self n: I32}
    returns r: I32
    requires Ordered.greater(n 0i32)
  endfn
endinterface
type A of I32
  impl Sized
    fn size takes {value: Self m: I32} returns s: I32 do return m endfn
  endimpl
endtype
fn measure(T) takes {t: T} returns r: I32 given {T: Sized} do return Sized.size(t 4i32) endfn
fn main returns r: I32 do return measure(A(1i32)) endfn

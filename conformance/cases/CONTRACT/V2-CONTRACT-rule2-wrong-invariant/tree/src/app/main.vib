type NonNegative of I32 where isNonNegative endtype
fn isNonNegative takes {v: I32} returns r: Bool do return Ordered.greaterOrEqual(v 0i32) endfn
fn pos takes {x: I32} returns r: I32 requires Ordered.greater(x 0i32) do return x endfn
fn f takes {p: NonNegative} returns r: I32 do let NonNegative(raw) be p endlet return pos(raw) endfn

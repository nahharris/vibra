fn f takes {x: I32} returns r: Result(Positive PositiveError) do let p: Result(Positive PositiveError) be Positive(x) endlet return p endfn
type PositiveError case notPositive endtype
type Positive of I32 where fn takes {raw: I32} returns ok: Bool do return Ordered.greater(raw 0i32) endfn else PositiveError.notPositive() endtype
fn unwrap takes {p: Positive} returns raw: I32 do let Positive(raw) be p endlet return raw endfn
fn code takes {p: Result(Positive PositiveError)} returns r: I32 do match p case Result.ok(value: q) return unwrap(q) case Result.err(error: PositiveError.notPositive()) return -1i32 endmatch endfn

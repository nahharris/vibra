interface Sized
  fn size takes {value: Self n: I32} returns r: I32 ensures Ordered.greater(r 0i32) endfn
endinterface
type Wrap(T) of T
  impl Sized
    fn size takes {value: Self m: I32} returns s: I32 do return m endfn
  endimpl
endtype
fn main returns r: I32 do return Sized.size(Wrap(1i32) 4i32) endfn

(defn execute () void
  (let - (walk 10000u64))
  (let - (stepper.step-hopped (counter left: 0u64) 10000u64)))

; A module value of function type holds a function, and a call through it in
; tail position reuses the activation.
(def hopper (fn (u64) u64) walk)

(defn walk (n u64) u64
  (if (u64.equal n 0u64)
    1u64
    (hopper (lower n))))

; The same holds when the module value is a contract member named as a value,
; which each implementation calls through in tail position.
(defint stepper
  (defn step-hopped (value self n u64) u64))

(deftype counter (record left u64)
  (impl stepper
    (defn step-hopped (value self n u64) u64
      (if (u64.equal n 0u64)
        20u64
        (member-hopper value (lower n))))))

(def member-hopper (fn (counter u64) u64) stepper.step-hopped)

(defn lower (count u64) u64
  (match (u64.sub-checked count 1u64)
    (result.ok value) value
    (result.err -) 0u64))

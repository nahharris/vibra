(import fs @std.fs)
(import io @std.io)

(defn main () (result void fs.fs-error)
  effects: (fs.read io.stdin io.stdout)
  (let name (match (io.stdin.text)
    (result.ok line) (str.trim line)
    (result.err -) ""))
  (let contents (try (fs.read.text (fs.path name))))
  (match (io.stdout.text (str.concat "> " contents))
    (result.ok) (result.ok)
    (result.err -) (result.ok)))

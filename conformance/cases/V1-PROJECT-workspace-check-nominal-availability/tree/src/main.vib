(deftype handle i32)
(deftype number (union i32 str))
(defint printable
  (defn render (value self) str)
  (impl i32
    (defn render (value self) str "integer")))
(deffect audit
  (defn record (message str) void
    external: @host
    symbol: "audit.record"))
(defn use-handle (value handle) i32 0i32)

(deffect write
  (defn text (target str) void (do)))

(deffect extra
  (defn more () void (do)))

(defint logger
  (defn log (value self) void
    effects: (write)))

(deftype console (record id i32)
  (impl logger
    (defn log (value self) void
      effects: (write)
      (write.text "console")
      (extra.more))))

(import option @std.option)

(defn main ()
  (tuple
    (option.option i32)
    (option.option i32)
    (option.option str)
    (option.option str)
    (option.option char)
    (option.option char))
  (let items (array.of 10i32 20i32)
    (let names (dict.of (tupleof 1i32 "a") "one")
      (tupleof
        (items 1u64)
        (items 2u64)
        (names (tupleof 1i32 "a"))
        (names (tupleof 2i32 "a"))
        ("héllo" 1u64)
        ("hi" 9u64)))))

(record
  format: @types.v1
  globals: (array
    (record name: @true type: @bool body: (record kind: @variant type: @bool variant: @true))
    (record name: @false type: @bool body: (record kind: @variant type: @bool variant: @false))
  )
  functions: (array
    (record name: @answer params: (array) result: @i32 body: (record kind: @sequence type: @i32 values: (array (record kind: @sequence type: @i32 values: (array (record kind: @literal type: @i8 value: 1i8) (record kind: @literal type: @i32 value: 42i32))))))
  )
)

use @std.assert enduse

interface Clock
  proc now takes {clock: Self} returns at: I64 endproc
endinterface

type Counter of {ticks: I64}
  impl Clock
    proc now takes {clock: Self} returns at: I64 do return 7i64 endproc
  endimpl
endtype

proc twice takes {tick: Proc({} I64 {Clock})} returns total: I64 performs {Clock} do
  let a be await tick() endlet
  return I64.add(a await tick())
endproc

test "callback" performs {Clock} do assert.equal(14i64 await twice(proc returns at: I64 performs {Clock} do return await Clock.now(Counter(ticks: 0i64)) endproc)) endtest

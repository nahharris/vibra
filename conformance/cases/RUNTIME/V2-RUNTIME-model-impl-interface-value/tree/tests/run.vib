use @std.assert enduse

interface Clock
  proc now takes {clock: Self} returns at: I64 endproc
endinterface

type Counter of {ticks: I64}
  impl Clock
    proc now takes {clock: Self} returns at: I64 do return 7i64 endproc
  endimpl
endtype

fn widen takes {clock: Clock} returns same: Clock do return clock endfn

test "value" performs {Clock} do assert.equal(7i64 await Clock.now(widen(Counter(ticks: 0i64)))) endtest

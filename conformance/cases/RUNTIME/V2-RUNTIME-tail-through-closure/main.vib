fn main returns r: I32 do return count(100000i32 0i32) endfn
fn count takes {n: I32 acc: I32} returns r: I32 do let next be fn takes {m: I32 a: I32} returns r: I32 do return count(m a) endfn endlet if Equatable.equal(n 0i32) then return acc else return next(I32.sub(n 1i32) I32.add(acc 1i32)) endif endfn

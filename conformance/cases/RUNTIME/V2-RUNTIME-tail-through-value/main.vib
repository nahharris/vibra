fn main returns r: I32 do return count(Stepper(step: count) 100000i32 0i32) endfn
type Stepper of {step: Fn({Stepper I32 I32} I32)} endtype
fn count takes {s: Stepper n: I32 acc: I32} returns r: I32 do if Equatable.equal(n 0i32) then return acc else return s.step(s I32.sub(n 1i32) I32.add(acc 1i32)) endif endfn

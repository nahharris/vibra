(import from @std.core.from)

(deftype celsius i64
  (impl (from i16)
    (defn convert (value i16) self
      (celsius 16i64))))

(defint scaled
  (defn area (value self) i32
    labelled: (scale i32 1i32)))

(defn no-such-source () (fn (str) celsius)
  from.convert)

(defn no-destination () (fn (i16) str)
  from.convert)

(defn labelled-member () (fn (i32) i32 labelled: (scale i32))
  scaled.area)

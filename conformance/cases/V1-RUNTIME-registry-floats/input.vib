(import core @std.core)

(import from @std.core.from)

(import try-from @std.core.try-from)

(defn main ()
  (tuple
    f64
    f32
    f64
    bool
    bool
    core.ordering
    core.ordering
    str
    str
    str
    str
    (result f64 core.conversion-error)
    (result f32 core.conversion-error)
    (result f64 core.conversion-error))
  (tupleof
    (f64.add 0.1f64 0.2f64)
    (f32.mul 1.5f32 -2.0f32)
    (f64.neg 0.0f64)
    (f64.equal (f64.div 0.0f64 0.0f64) (f64.div 0.0f64 0.0f64))
    (f64.equal -0.0f64 0.0f64)
    (f64.compare-total -0.0f64 0.0f64)
    (f32.compare-total (f32.div 1.0f32 0.0f32) (f32.div 0.0f32 0.0f32))
    (from.convert 100.0f64)
    (from.convert 1.0e20f64)
    (from.convert (f32.div -1.0f32 0.0f32))
    (from.convert (f64.div 0.0f64 0.0f64))
    (try-from.convert "2.5e-3")
    (try-from.convert "1e39")
    (try-from.convert "12")))

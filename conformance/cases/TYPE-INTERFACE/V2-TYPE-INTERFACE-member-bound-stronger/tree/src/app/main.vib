fn main returns r: F32 do return 1f32 endfn

interface Pick
  fn pick(T)
    takes {x: Self item: T}
    returns r: T
  endfn
endinterface

type Box of U8
  impl Pick
    fn pick(T)
      takes {x: Self item: T}
      returns r: T
      given {T: Ordered}
      do
        return Ordered.max(item item)
    endfn
  endimpl
endtype

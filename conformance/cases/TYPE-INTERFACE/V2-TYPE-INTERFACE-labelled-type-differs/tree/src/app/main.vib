fn main returns r: I32 do return 1i32 endfn

interface Pad
  fn pad
    takes {value: Self}
    labelled {width: U8 be 2u8}
    returns r: U8
  endfn
endinterface
type Cell of U8
  impl Pad
    fn pad
      takes {value: Self}
      labelled {width: U16 be 2u16}
      returns r: U8
      do
        return 0u8
    endfn
  endimpl
endtype

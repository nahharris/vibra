fn main
  returns r: I32
  do
    let f: Fn({Celsius} Str) be Printable.render endlet
    return 1i32
endfn

interface Printable
  fn render
    takes {value: Self}
    returns text: Str
  endfn
endinterface
type Celsius of I32
  impl Printable
    fn render
      takes {value: Self}
      returns text: Str
      do
        return "warm"
    endfn
  endimpl
endtype
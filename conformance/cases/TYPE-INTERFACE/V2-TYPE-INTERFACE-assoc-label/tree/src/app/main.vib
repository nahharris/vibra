fn main returns r: Bool do return isOne(Once(Option.some(value: 1u8))) endfn

fn isOne(I)
  takes {it: I}
  returns r: Bool
  given {I: Iter(Item: U8)}
  do
    match Iter.next(it)
      case Option.some(value: {n _})
        return Equatable.equal(n 1u8)
      case Option.none()
        return false
    endmatch
endfn

type Once of Option(U8)
  impl Iter
    type Item of U8 endtype
    fn next
      takes {value: Self}
      returns step: Option({Item Self})
      do
        match value
          case Once(Option.some(value: item))
            return Option.some(value: {item Once(Option.none())})
          case Once(Option.none())
            return Option.none()
        endmatch
    endfn
  endimpl
endtype
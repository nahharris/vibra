fn main returns r: {U8 U8} do return {Pad.wide(Cell(1u8)) Pad.wide(Cell(1u8) extra: 7u8)} endfn

interface Pad
  fn pad
    takes {value: Self}
    returns r: U8
  endfn
  fn wide
    takes {value: Self}
    labelled {extra: U8 be 1u8}
    returns r: U8
    do
      return U8.add(Pad.pad(value) extra)
  endfn
endinterface

type Cell of U8
  impl Pad
    fn pad
      takes {value: Self}
      returns r: U8
      do
        let Cell(n) be value endlet
        return n
    endfn
  endimpl
endtype
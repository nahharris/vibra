fn main
  returns r: List(I32)
  do
    return Iter.collect(Iter.filter(Iter.map([1i32 2i32 3i32] double) isEven))
endfn

fn double takes {x: I32} returns r: I32 do return I32.mul(x 2i32) endfn

fn isEven
  takes {x: I32}
  returns r: Bool
  do
    match I32.remChecked(x 2i32)
      case Result.ok(value: 0i32)
        return true
      case _
        return false
    endmatch
endfn

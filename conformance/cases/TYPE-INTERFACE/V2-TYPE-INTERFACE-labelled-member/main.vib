fn main
  returns r: {U8 U8 U8}
  do
    let p: Pad be Cell(1u8) endlet
    return {Pad.pad(Cell(1u8)) Pad.pad(Cell(1u8) width: 5u8) Pad.pad(p)}
endfn

interface Pad
  fn pad
    takes {value: Self}
    labelled {width: U8 be 2u8}
    returns r: U8
  endfn
endinterface
type Cell of U8
  impl Pad
    fn pad
      takes {value: Self}
      labelled {width: U8 be 2u8}
      returns r: U8
      do
        return width
    endfn
  endimpl
endtype
use @std.policy enduse

fn name
  takes {error: policy.ScopeError}
  returns text: Str
  do
    match error
      case policy.ScopeError.invalidPolicy()
        return "invalidPolicy"
      case policy.ScopeError.unsupportedVersion()
        return "unsupportedVersion"
      case policy.ScopeError.policyTooComplex()
        return "policyTooComplex"
      case policy.ScopeError.foreignRoot()
        return "foreignRoot"
    endmatch
endfn

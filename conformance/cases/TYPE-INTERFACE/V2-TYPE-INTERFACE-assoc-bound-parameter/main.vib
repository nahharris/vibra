fn main returns r: Option(U8) do return first(Once(Option.some(value: 1u8))) endfn

fn first(T I)
  takes {it: I}
  returns r: Option(T)
  given {I: Iter(Item: T)}
  do
    match Iter.next(it)
      case Option.some(value: {item _})
        return Option.some(value: item)
      case Option.none()
        return Option.none()
    endmatch
endfn

type Once of Option(U8)
  impl Iter
    type Item of U8 endtype
    fn next
      takes {value: Self}
      returns step: Option({Item Self})
      do
        match value
          case Once(Option.some(value: item))
            return Option.some(value: {item Once(Option.none())})
          case Once(Option.none())
            return Option.none()
        endmatch
    endfn
  endimpl
endtype
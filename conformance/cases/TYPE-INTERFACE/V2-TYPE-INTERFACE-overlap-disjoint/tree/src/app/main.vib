fn main returns r: I32 do return 1i32 endfn

type Tag
  case only
  impl From(I8)
    fn convert
      takes {value: I8}
      returns converted: Self
      do
        return Tag.only()
    endfn
  endimpl
  impl From(I16)
    fn convert
      takes {value: I16}
      returns converted: Self
      do
        return Tag.only()
    endfn
  endimpl
endtype
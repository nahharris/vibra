# syntax=docker/dockerfile:1
ARG RUST_BUILDER_IMAGE=rust:1.94.1-slim-bookworm@sha256:cf9dd0ec73e75f827fe59123fff9dc65af1a1c8363c3c31ee8d7f8ad0b6a5fb2
ARG RUST_DEV_IMAGE=rust:1.94.1-alpine@sha256:77237dd363a0b127bb5ef532c2d64c0deb380b738e43a9c4bdac73398d6d0a08
ARG LINUX_RUNTIME_IMAGE=gcr.io/distroless/cc-debian12:nonroot@sha256:ce0d66bc0f64aae46e6a03add867b07f42cc7b8799c949c2e898057b7f75a151
ARG VIBRA_VERSION=0.1.0
ARG VIBRA_REVISION=0000000000000000000000000000000000000000
ARG SOURCE_DATE_EPOCH=0

FROM ${RUST_BUILDER_IMAGE} AS builder
ARG VIBRA_VERSION
ARG VIBRA_REVISION
ARG SOURCE_DATE_EPOCH
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

RUN apt-get update \
    && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends build-essential ca-certificates git libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
RUN mkdir -p src \
    && printf 'pub fn dependency_cache_seed() {}\n' > src/lib.rs \
    && printf 'fn main() {}\n' > src/main.rs \
    && cargo build --release --locked \
    && rm -rf src
COPY src ./src
RUN touch src/lib.rs src/main.rs \
    && cargo build --release --locked
COPY stdlib ./stdlib
RUN files="$(find stdlib -type f -printf '%P\n' | LC_ALL=C sort)" \
    && digest="$(printf '%s\n' "$files" | while IFS= read -r file; do printf '%s %s\n' "$file" "$(sha256sum "stdlib/$file" | cut -d' ' -f1)"; done | sha256sum | cut -d' ' -f1)" \
    && stdrev="$(sed -n 's/.*STDLIB_REV: &str = "\([0-9a-f]*\)".*/\1/p' src/project.rs)" \
    && printf 'format-version: 1\nversion: %s\nrevision: %s\nplatform: linux-container\nstdlib-git: https://github.com/nahharris/vibra-stdlib.git\nstdlib-rev: %s\nstdlib-sha256: %s\n' "$VIBRA_VERSION" "$VIBRA_REVISION" "$stdrev" "$digest" > release.vibra

FROM ${RUST_DEV_IMAGE} AS dev-builder
ENV LLVM_CONFIG_PATH=/usr/bin/llvm21-config
RUN apk upgrade --no-cache \
    && apk add --no-cache build-base clang-dev clang-static git llvm-dev llvm-static openssl-dev openssl-libs-static pkgconf zlib-static
WORKDIR /src
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
RUN mkdir -p src \
    && printf 'pub fn dependency_cache_seed() {}\n' > src/lib.rs \
    && printf 'fn main() {}\n' > src/main.rs \
    && cargo build --release --locked \
    && rm -rf src
COPY src ./src
RUN touch src/lib.rs src/main.rs \
    && cargo build --release --locked
COPY stdlib ./stdlib
COPY --from=builder /src/release.vibra ./release.vibra

FROM ${RUST_DEV_IMAGE} AS dev
ENV LLVM_CONFIG_PATH=/usr/bin/llvm21-config
RUN apk upgrade --no-cache \
    && apk add --no-cache build-base clang-dev clang-static git llvm-dev llvm-static openssl-dev openssl-libs-static pkgconf zlib-static \
    && install -d /opt/vibra/bin /opt/vibra/stdlib
COPY --from=dev-builder /src/target/release/vibra /opt/vibra/bin/vibra
COPY --from=dev-builder /src/stdlib /opt/vibra/stdlib
COPY --from=dev-builder /src/release.vibra /opt/vibra/release.vibra
RUN cargo --version \
    && dirname "$(command -v cargo)" > /opt/vibra/cargo-bin \
    && git --version
ENV PATH="/opt/vibra/bin:/root/.cargo/bin:/usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
WORKDIR /workspace
ENTRYPOINT ["vibra"]
CMD ["--help"]

FROM ${LINUX_RUNTIME_IMAGE} AS runtime
COPY --from=builder --chown=nonroot:nonroot /src/target/release/vibra /opt/vibra/bin/vibra
COPY --from=builder --chown=nonroot:nonroot /src/stdlib /opt/vibra/stdlib
COPY --from=builder --chown=nonroot:nonroot /src/release.vibra /opt/vibra/release.vibra
ENV PATH="/opt/vibra/bin"
USER nonroot
ENTRYPOINT ["/opt/vibra/bin/vibra"]
CMD ["--help"]

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/release-metadata.schema.json",
  "title": "Vibra native toolchain release metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["format-version", "version", "revision", "platform", "stdlib-git", "stdlib-rev", "stdlib-sha256"],
  "properties": {
    "format-version": { "const": 1 },
    "version": { "type": "string" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "platform": { "enum": ["linux-amd64", "linux-arm64", "windows-amd64"] },
    "stdlib-git": { "const": "https://github.com/nahharris/vibra-stdlib.git" },
    "stdlib-rev": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "stdlib-sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

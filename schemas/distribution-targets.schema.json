{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/distribution-targets.schema.json",
  "title": "Vibra native distribution target matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["format-version", "targets"],
  "properties": {
    "$schema": { "type": "string" },
    "format-version": { "const": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "target-triple",
          "os",
          "architecture",
          "support-tier",
          "runner",
          "archive-extension"
        ],
        "properties": {
          "platform": {
            "enum": [
              "linux-amd64",
              "linux-arm64",
              "windows-amd64",
              "macos-amd64",
              "macos-arm64"
            ]
          },
          "target-triple": {
            "enum": [
              "x86_64-unknown-linux-gnu",
              "aarch64-unknown-linux-gnu",
              "x86_64-pc-windows-msvc",
              "x86_64-apple-darwin",
              "aarch64-apple-darwin"
            ]
          },
          "os": { "enum": ["linux", "windows", "macos"] },
          "architecture": { "enum": ["amd64", "arm64"] },
          "support-tier": { "enum": ["tier-1", "best-effort"] },
          "runner": { "type": "string", "minLength": 1 },
          "archive-extension": { "enum": ["tar.gz", "zip"] }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/index.schema.json",
  "title": "Vibra normalized retrieval index",
  "description": "A deterministic, function-level retrieval corpus. Consumers must apply vibra fmt normalization symmetrically to both query and corpus text, preserving comments and identifiers. Evaluation should prioritize rejection precision (elimination of candidates rejected by the verifier), not top-k ranking.",
  "type": "object",
  "required": ["records", "version"],
  "properties": {
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    },
    "version": {
      "const": 1
    }
  },
  "additionalProperties": false,
  "$defs": {
    "effect-set": {
      "type": "object",
      "required": ["declared", "inferred", "performed"],
      "properties": {
        "declared": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inferred": {
          "anyOf": [
            {
              "type": "array",
              "items": { "type": "string" }
            },
            { "type": "null" }
          ],
          "description": "Reserved integration seam for #249 effect inference; null means this compiler does not yet expose a distinct inferred row."
        },
        "performed": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "call-site": { "$ref": "#/$defs/source-location" },
        "definition-site": { "$ref": "#/$defs/source-location" },
        "kind": {
          "enum": ["generated", "source", "expansion"]
        }
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type", "variadic"],
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "variadic": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "call-edges",
        "effects",
        "error-types",
        "generated",
        "module-path",
        "origin",
        "qualified-name",
        "signature",
        "source",
        "visibility"
      ],
      "properties": {
        "call-edges": {
          "type": "array",
          "items": { "type": "string" }
        },
        "effects": { "$ref": "#/$defs/effect-set" },
        "error-types": {
          "type": "array",
          "items": { "type": "string" }
        },
        "generated": { "type": "boolean" },
        "module-path": { "type": "string" },
        "origin": { "$ref": "#/$defs/origin" },
        "qualified-name": { "type": "string" },
        "signature": { "$ref": "#/$defs/signature" },
        "source": {
          "type": "string",
          "description": "vibra fmt-normalized function source; generated definitions have no fabricated authored source and use the empty string."
        },
        "visibility": {
          "enum": ["private", "public"]
        }
      },
      "additionalProperties": false
    },
    "signature": {
      "type": "object",
      "required": ["parameters", "return", "type-parameters"],
      "properties": {
        "parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/parameter" }
        },
        "return": { "type": "string" },
        "type-parameters": {
          "type": "array",
          "items": { "$ref": "#/$defs/type-parameter" }
        }
      },
      "additionalProperties": false
    },
    "source-location": {
      "type": "object",
      "required": ["document", "end", "start"],
      "properties": {
        "document": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "start": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "type-parameter": {
      "type": "object",
      "required": ["bounds", "name"],
      "properties": {
        "bounds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/test-report.schema.json",
  "title": "Vibra test report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mode",
    "total",
    "passed",
    "failed",
    "timed_out",
    "skipped",
    "duration_ms",
    "tests"
  ],
  "properties": {
    "mode": { "enum": ["test", "benchmark"] },
    "total": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "timed_out": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/testResult" }
    }
  },
  "$defs": {
    "testResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "case",
        "path",
        "status",
        "duration_ms",
        "stdout",
        "stderr",
        "message",
        "profile",
        "tags",
        "skip_reason",
        "warnings"
      ],
      "properties": {
        "scenario": { "type": "string", "minLength": 1 },
        "case": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["passed", "failed", "timed_out", "skipped"]
        },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "stdout": { "type": "string" },
        "stderr": { "type": "string" },
        "message": { "type": "string" },
        "profile": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "skip_reason": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" }
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0
        },
        "clock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unix_millis", "monotonic_millis"],
          "properties": {
            "unix_millis": { "type": "integer", "minimum": 0 },
            "monotonic_millis": { "type": "integer", "minimum": 0 }
          }
        },
        "benchmark": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "iterations",
            "warmup_iterations",
            "samples_ns",
            "min_ns",
            "median_ns",
            "max_ns",
            "mean_ns"
          ],
          "properties": {
            "iterations": { "type": "integer", "minimum": 1 },
            "warmup_iterations": { "type": "integer", "minimum": 0 },
            "samples_ns": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "minimum": 0 }
            },
            "min_ns": { "type": "integer", "minimum": 0 },
            "median_ns": { "type": "integer", "minimum": 0 },
            "max_ns": { "type": "integer", "minimum": 0 },
            "mean_ns": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/effects.schema.json",
  "title": "Vibra static effect surface",
  "type": "object",
  "required": ["effects"],
  "properties": {
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "module", "name", "params", "return"],
        "properties": {
          "source": { "type": "string" },
          "module": { "enum": ["vibra_v1", "vibra_test"] },
          "name": { "type": "string" },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": { "type": { "type": "string" } },
              "additionalProperties": false
            }
          },
          "return": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

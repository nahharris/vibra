{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/effects-v3.schema.json",
  "title": "Vibra nominal effect surface",
  "description": "Static nominal effect report with explicit declared/performed surfaces, operation ownership, and primitive witnesses.",
  "type": "object",
  "required": ["surface", "functions", "operations", "primitives"],
  "properties": {
    "surface": {
      "type": "object",
      "required": ["declared", "performed"],
      "properties": {
        "declared": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "performed": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
      },
      "additionalProperties": false
    },
    "functions": {
      "type": "array",
      "items": { "$ref": "#/$defs/function" }
    },
    "operations": {
      "type": "array",
      "items": { "$ref": "#/$defs/operation" }
    },
    "primitives": {
      "type": "array",
      "items": { "$ref": "#/$defs/primitive" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "effect": {
      "type": "object",
      "required": ["domain", "action"],
      "properties": {
        "domain": { "type": "string" },
        "action": { "type": "string" }
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": ["source", "declared", "performed", "call-edges", "primitive-witnesses"],
      "properties": {
        "source": { "type": "string" },
        "declared": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "performed": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "call-edges": { "type": "array", "items": { "type": "string" } },
        "primitive-witnesses": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["source", "owner", "additive", "declared", "performed", "call-edges", "primitive-witnesses"],
      "properties": {
        "source": { "type": "string" },
        "owner": { "$ref": "#/$defs/effect" },
        "additive": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "declared": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "performed": { "type": "array", "items": { "$ref": "#/$defs/effect" } },
        "call-edges": { "type": "array", "items": { "type": "string" } },
        "primitive-witnesses": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "primitive": {
      "type": "object",
      "required": ["source", "module", "name", "intrinsic", "input-capabilities", "result-capability", "required-roots"],
      "properties": {
        "source": { "type": "string" },
        "module": { "type": "string" },
        "name": { "type": "string" },
        "intrinsic": { "type": "boolean" },
        "input-capabilities": { "type": "array", "items": { "type": "string" } },
        "result-capability": { "type": "string" },
        "required-roots": { "type": "array", "items": { "$ref": "#/$defs/effect" } }
      },
      "additionalProperties": false
    }
  }
}

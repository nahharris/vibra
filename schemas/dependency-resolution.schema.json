{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/dependency-resolution.schema.json",
  "title": "VibraDependencyResolution",
  "oneOf": [
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/conflict" }
  ],
  "$defs": {
    "identity": { "type": "string", "pattern": "^https?://.+#/.*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "edge": {
      "type": "object",
      "required": ["from", "alias", "to", "requirement"],
      "additionalProperties": false,
      "properties": {
        "from": { "oneOf": [{ "const": "root" }, { "$ref": "#/$defs/identity" }] },
        "from-version": { "$ref": "#/$defs/version" },
        "alias": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
        "to": { "$ref": "#/$defs/identity" },
        "requirement": { "type": "string", "minLength": 1 }
      }
    },
    "selection": {
      "type": "object",
      "required": ["package", "version", "rev"],
      "additionalProperties": false,
      "properties": {
        "package": { "$ref": "#/$defs/identity" },
        "version": { "$ref": "#/$defs/version" },
        "rev": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "success": {
      "type": "object",
      "required": ["resolution-version", "outcome", "selections"],
      "additionalProperties": false,
      "properties": {
        "resolution-version": { "const": 1 },
        "outcome": { "const": "success" },
        "selections": {
          "type": "array",
          "items": { "$ref": "#/$defs/selection" }
        },
        "cache-digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "conflict": {
      "type": "object",
      "required": ["resolution-version", "outcome", "code", "package", "requirements", "available"],
      "additionalProperties": false,
      "properties": {
        "resolution-version": { "const": 1 },
        "outcome": { "const": "conflict" },
        "code": {
          "enum": [
            "E-RESOLVE-CONFLICT",
            "E-RESOLVE-STDLIB-CONFLICT",
            "E-RESOLVE-AMBIGUOUS-TAG",
            "E-RESOLVE-MUTABLE-TAG",
            "E-RESOLVE-OFFLINE-MISS"
          ]
        },
        "package": { "$ref": "#/$defs/identity" },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["chain"],
            "additionalProperties": false,
            "properties": {
              "chain": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/edge" }
              }
            }
          }
        },
        "available": {
          "type": "array",
          "items": { "$ref": "#/$defs/version" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/source-annotations.schema.json",
  "title": "VibraSourceAnnotations",
  "type": "object",
  "properties": {
    "=comment": {
      "type": "string"
    },
    "=lint": {
      "type": "object",
      "required": ["disable"],
      "additionalProperties": false,
      "properties": {
        "disable": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["all", "W-STYLE-001", "W-STYLE-003"]
          }
        }
      }
    }
  }
}

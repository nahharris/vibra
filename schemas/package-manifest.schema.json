{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/package-manifest.schema.json",
  "title": "Vibra application package JSON metadata",
  "description": "Canonical compact UTF-8 JSON stored as package.json in a format-version 2 .vapp archive, with one trailing LF.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format-version", "name", "version", "target", "runtime-abi", "compiler-version", "stdlib-git", "stdlib-rev", "entry", "compilation-flags", "selected-sources", "files"],
  "properties": {
    "format-version": { "const": 2 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "minLength": 1 },
    "runtime-abi": { "const": "vibra-v1" },
    "compiler-version": { "type": "string", "minLength": 1 },
    "stdlib-git": { "type": "string", "format": "uri" },
    "stdlib-rev": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "entry": { "type": "string", "pattern": "^source/.+\\.vibra$" },
    "compilation-flags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
      "uniqueItems": true
    },
    "selected-sources": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "files": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "pattern": "^(program\\.wasm|source/.+)$" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    }
  }
}

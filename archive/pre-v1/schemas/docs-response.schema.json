{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/docs-response.schema.json",
  "title": "VibraDocsResponse",
  "description": "Structured JSON output from `vibra docs`. A symbol lookup returns one record; browse mode returns an array.",
  "oneOf": [
    { "$ref": "#/$defs/documentation" },
    {
      "type": "array",
      "items": { "$ref": "#/$defs/documentation" }
    }
  ],
  "$defs": {
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "kind", "documentation", "module"],
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "package",
            "module",
            "function",
            "type",
            "enum",
            "interface",
            "constant",
            "macro",
            "test",
            "symbol"
          ]
        },
        "documentation": { "type": "string" },
        "module": { "type": "string", "minLength": 1 }
      }
    }
  }
}

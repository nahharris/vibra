{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibra.dev/schemas/lsp-compilation-options.schema.json",
  "title": "Vibra LSP compilation options",
  "type": "object",
  "required": ["compilationFlags"],
  "properties": {
    "compilationFlags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}

{
  "format": 1,
  "notation": "Each package maps versions to dependency identity/range pairs; revisions use the version digits repeated to 40 hex characters.",
  "vectors": [
    {
      "name": "compatible-diamond-prefers-highest",
      "root": { "left": ["left", "^1.0.0"], "right": ["right", "^1.0.0"] },
      "packages": {
        "left": { "1.0.0": { "common": ["common", ">=1.0.0 <3.0.0"] } },
        "right": { "1.0.0": { "common": ["common", "^2.0.0"] } },
        "common": { "1.9.0": {}, "2.0.0": {}, "2.1.0": {} }
      },
      "expected": { "selected": { "common": "2.1.0", "left": "1.0.0", "right": "1.0.0" } }
    },
    {
      "name": "incompatible-diamond-reports-both-chains",
      "root": { "left": ["left", "^1.0.0"], "right": ["right", "^1.0.0"] },
      "packages": {
        "left": { "1.0.0": { "common": ["common", "^1.0.0"] } },
        "right": { "1.0.0": { "common": ["common", "^2.0.0"] } },
        "common": { "1.9.0": {}, "2.1.0": {} }
      },
      "expected": {
        "error": "E-RESOLVE-CONFLICT",
        "package": "common",
        "chains": [["left", "common"], ["right", "common"]]
      }
    },
    {
      "name": "multiple-versions-are-not-selected",
      "root": { "old": ["common", "^1.0.0"], "new": ["common", "^2.0.0"] },
      "packages": { "common": { "1.5.0": {}, "2.5.0": {} } },
      "expected": { "error": "E-RESOLVE-CONFLICT", "package": "common", "selection-count": 0 }
    },
    {
      "name": "prerelease-requires-explicit-comparator",
      "root": { "common": ["common", "^2.0.0"] },
      "packages": { "common": { "2.0.0-beta.2": {}, "1.9.0": {} } },
      "expected": { "error": "E-RESOLVE-CONFLICT", "package": "common" }
    },
    {
      "name": "explicit-prerelease-selects-prerelease",
      "root": { "common": ["common", ">=2.0.0-beta.1 <2.0.0"] },
      "packages": { "common": { "2.0.0-beta.1": {}, "2.0.0-beta.2": {}, "1.9.0": {} } },
      "expected": { "selected": { "common": "2.0.0-beta.2" } }
    },
    {
      "name": "stdlib-range-conflict-is-specific",
      "root": { "std": ["std", "^2.0.0"], "library": ["library", "1.0.0"] },
      "packages": {
        "library": { "1.0.0": { "std": ["std", "^1.0.0"] } },
        "std": { "1.8.0": {}, "2.1.0": {} }
      },
      "expected": { "error": "E-RESOLVE-STDLIB-CONFLICT", "package": "std" }
    },
    {
      "name": "root-replacement-applies-transitively",
      "root": { "library": ["library", "^1.0.0"] },
      "replacements": { "common": { "identity": "common-fork", "version": "1.4.1", "rev": "1411411411411411411411411411411411411411" } },
      "packages": {
        "library": { "1.0.0": { "common": ["common", "^1.4.0"] } },
        "common": { "1.4.0": {} },
        "common-fork": { "1.4.1": {} }
      },
      "expected": { "selected": { "common-fork": "1.4.1", "library": "1.0.0" }, "replaced": "common" }
    },
    {
      "name": "minimal-change-keeps-compatible-lock",
      "root": { "common": ["common", "^1.0.0"] },
      "packages": { "common": { "1.1.0": {}, "1.2.0": {} } },
      "prior-lock": { "common": "1.1.0" },
      "mode": "sync",
      "expected": { "selected": { "common": "1.1.0" } }
    },
    {
      "name": "targeted-update-unlocks-requested-package",
      "root": { "common": ["common", "^1.0.0"] },
      "packages": { "common": { "1.1.0": {}, "1.2.0": {} } },
      "prior-lock": { "common": "1.1.0" },
      "mode": "update:common",
      "expected": { "selected": { "common": "1.2.0" } }
    },
    {
      "name": "offline-locked-needs-no-index",
      "root": { "common": ["common", "^1.0.0"] },
      "packages": {},
      "prior-lock": { "common": "1.1.0" },
      "vendored": { "common": { "version": "1.1.0", "tree-hash-valid": true } },
      "mode": "locked-offline",
      "expected": { "selected": { "common": "1.1.0" }, "network-requests": 0 }
    },
    {
      "name": "offline-without-lock-fails-closed",
      "root": { "common": ["common", "^1.0.0"] },
      "packages": {},
      "mode": "locked-offline",
      "expected": { "error": "E-RESOLVE-OFFLINE-MISS", "package": "common", "network-requests": 0 }
    }
  ]
}

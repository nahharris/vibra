(import test "../stdlib/src/test.vib")
(import io "../stdlib/src/io.vib")
(import result "../stdlib/src/result.vib")
(test.scenario
  "print-statement-runs"
  (test.case
    "print-statement-runs"
    profile: @core
    (let r (io.stdout.print "stdout from vibra test"))
    (match r
      (result.result.ok) (test.assert true)
      (result.result.err _) (test.fail "print returned err"))))
(test.scenario
  "println-returns-ok"
  (test.case
    "println-returns-ok"
    profile: @core
    (let r (io.stdout.println "line from vibra test"))
    (match r
      (result.result.ok) (test.assert true)
      (result.result.err _) (test.fail "println returned err"))))
(test.scenario
  "eprintln-statement-runs"
  (test.case
    "eprintln-statement-runs"
    profile: @core
    (let r (io.stderr.println "stderr from vibra test"))
    (match r
      (result.result.ok) (test.assert true)
      (result.result.err _) (test.fail "eprintln returned err"))))

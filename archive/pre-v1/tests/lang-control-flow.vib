(import test "../stdlib/src/test.vib")
(test.scenario
  "if-true-takes-then"
  (test.case
    "if-true-takes-then"
    profile: @core
    (if true
      (test.assert true)
      (test.fail "then branch was skipped"))))
(test.scenario
  "if-false-takes-else"
  (test.case
    "if-false-takes-else"
    profile: @core
    (if false
      (test.fail "then branch ran on false")
      (test.assert true))))
(test.scenario
  "if-on-bound-condition"
  (test.case
    "if-on-bound-condition"
    profile: @core
    (let flag true)
    (if flag
      (test.assert true)
      (test.fail "bound true condition took else"))))
(test.scenario
  "nested-if"
  (test.case
    "nested-if"
    profile: @core
    (if true
      (if false
        (test.fail "inner false took then")
        (test.assert true))
      (test.fail "outer true took else"))))
(test.scenario
  "while-false-never-runs"
  (test.case
    "while-false-never-runs"
    profile: @core
    (while false (test.fail "while body ran on false condition"))
    (test.assert true)))

(import test "../stdlib/src/test.vib")
(test.scenario
  "structured-task-captures-immutable-snapshot"
  (test.case
    "structured-task-captures-immutable-snapshot"
    profile: @core
    tags: (@language @tasks)
    (let answer 42)
    (task
      captures: (answer)
      (match answer
        42 (test.assert true)
        _ (test.fail "task capture changed")))))
(test.scenario
  "structured-task-rejects-mutable-capture"
  (test.case
    "structured-task-rejects-mutable-capture"
    profile: @core
    tags: (@language @tasks @diagnostics)
    expect-error: (@compile E-TASK-001 "immutable snapshot")
    (let count (mut 0))
    (task captures: (count))))
(test.scenario
  "spawned-task-handles-overlap-and-join-out-of-order"
  (test.case
    "spawned-task-handles-overlap-and-join-out-of-order"
    profile: @core
    tags: (@language @tasks)
    (let base 40)
    (spawn first (add base 1) captures: (base))
    (spawn second (add base 2) captures: (base))
    (join second second-result)
    (join first first-result)
    (test.assert-eq-int second-result 42)
    (test.assert-eq-int first-result 41)))
(test.scenario
  "spawned-task-handle-is-affine"
  (test.case
    "spawned-task-handle-is-affine"
    profile: @core
    tags: (@language @tasks @diagnostics)
    expect-error: (@compile E-TASK-003 "unknown or was already joined")
    (spawn answer 42 captures: ())
    (join answer once)
    (join answer twice)))
(test.scenario
  "spawned-task-handle-cannot-be-copied"
  (test.case
    "spawned-task-handle-cannot-be-copied"
    profile: @core
    tags: (@language @tasks @diagnostics)
    expect-error: (@compile E-TASK-003 "consume it with `$join`")
    (spawn answer 42 captures: ())
    (let copy answer)
    (join answer result)))
(test.scenario
  "spawned-task-must-be-joined-before-scope-exit"
  (test.case
    "spawned-task-must-be-joined-before-scope-exit"
    profile: @core
    tags: (@language @tasks @diagnostics)
    expect-error: (@compile E-TASK-003 "must be joined")
    (spawn abandoned 42 captures: ())))

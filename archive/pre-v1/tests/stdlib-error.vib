(import test "../stdlib/src/test.vib")
(import error "../stdlib/src/error.vib")
(import env "../stdlib/src/env.vib")
(import fs "../stdlib/src/fs.vib")
(test.scenario
  "context-preserves-structured-detail"
  (test.case
    "context-preserves-structured-detail"
    profile: @core
    (let kind (error.error-kind.io))
    (match kind
      (error.error-kind.io) (test.assert true)
      _ (test.fail "error context lost structured detail"))))
(test.scenario
  "host-errors-share-kind-contract"
  (test.case
    "host-errors-share-kind-contract"
    profile: @core
    (let missing-file (fs.fs-error.not-found))
    (let invalid-env (env.env-error.invalid-name))
    (match (fs.error-kind missing-file)
      (error.error-kind.not-found)
        (match (env.error-kind invalid-env)
          (error.error-kind.invalid-input) (test.assert true)
          _ (test.fail "env error kind was not normalized"))
      _ (test.fail "filesystem error kind was not normalized"))))

(import test "../stdlib/src/test.vib")
(defn truthy () bool
  (return true))
(defn echo-int (subject int64) int64
  (return subject))
(test.scenario "many-1" (test.case "many-1" profile: @core (test.assert true)))
(test.scenario
  "many-2"
  (test.case "many-2" profile: @core (let flag true) (test.assert flag)))
(test.scenario
  "many-3"
  (test.case "many-3" profile: @core (let v (truthy)) (test.assert v)))
(test.scenario
  "many-4"
  (test.case
    "many-4"
    profile: @core
    (let n (echo-int 4))
    (match n
      4 (test.assert true)
      _ (test.fail "expected 4"))))
(test.scenario
  "many-5"
  (test.case
    "many-5"
    profile: @core
    (let n (echo-int 5))
    (match n
      5 (test.assert true)
      _ (test.fail "expected 5"))))
(test.scenario
  "many-6"
  (test.case
    "many-6"
    profile: @core
    (let s "shared-context")
    (match s
      "shared-context" (test.assert true)
      _ (test.fail "expected shared-context"))))
(test.scenario
  "many-7"
  (test.case
    "many-7"
    profile: @core
    (let x 2.5)
    (match x
      2.5 (test.assert true)
      _ (test.fail "expected 2.5"))))
(test.scenario
  "many-8"
  (test.case "many-8" profile: @core (let v (truthy)) (test.assert v)))
(test.scenario "many-9" (test.case "many-9" profile: @core (test.assert true)))
(test.scenario
  "many-10"
  (test.case
    "many-10"
    profile: @core
    (let n (echo-int 10))
    (match n
      10 (test.assert true)
      _ (test.fail "expected 10"))))
(test.scenario
  "many-11"
  (test.case "many-11" profile: @core (let flag true) (test.assert flag)))
(test.scenario
  "many-12"
  (test.case
    "many-12"
    profile: @core
    (let n (echo-int 12))
    (match n
      12 (test.assert true)
      _ (test.fail "expected 12"))))

(import test "../stdlib/src/test.vib")
(import net "../stdlib/src/net.vib")
(import result "../stdlib/src/result.vib")
(test.scenario
  "address-parsing-is-typed"
  (test.case
    "address-parsing-is-typed"
    profile: @core
    tags: (@stdlib @network)
    (let valid (net.parse-address "127.0.0.1:8080"))
    (match valid
      (result.result.ok _) (test.assert true)
      _ (test.fail "valid socket address was rejected"))
    (let invalid (net.parse-address "not-an-address"))
    (match invalid
      (result.result.err (net.net-error.invalid-address _)) (test.assert true)
      _ (test.fail "invalid socket address was accepted"))))

(import test "../stdlib/src/test.vib")
(test.scenario
  "compile-time-template-renders-sections"
  (test.case
    "compile-time-template-renders-sections"
    profile: @core
    (let
      rendered
      (template
        "template-assets/greeting.txt"
        with: (record
          (greeting "Hello")
          (people (array (record (name "Ada")) (record (name "Lin")))))))
    (match rendered
      "Hello: Ada, Lin, \n" (test.assert true)
      _ (test.fail "compile-time template rendered unexpected text"))))

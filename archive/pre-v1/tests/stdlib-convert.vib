(import test "../stdlib/src/test.vib")
(import convert "../stdlib/src/convert.vib")
(import result "../stdlib/src/result.vib")
(test.scenario
  "integer-parse-format-and-errors"
  (test.case
    "integer-parse-format-and-errors"
    profile: @core
    (let parsed (convert.parse-int64 "-42"))
    (match parsed
      (result.result.ok -42) (test.assert-eq-str (convert.format-int64 -42) "-42")
      _ (test.fail "signed integer round trip failed"))
    (let invalid (convert.parse-int64 "42x"))
    (match invalid
      (result.result.err (convert.parse-error.invalid)) (test.assert true)
      _ (test.fail "invalid integer was accepted"))
    (let overflow (convert.parse-int64 "9223372036854775808"))
    (match overflow
      (result.result.err (convert.parse-error.overflow)) (test.assert true)
      _ (test.fail "integer overflow was not typed"))))
(test.scenario
  "float-special-values-and-round-trip"
  (test.case
    "float-special-values-and-round-trip"
    profile: @core
    (test.assert-eq-str (convert.format-float64 1.25) "1.25")
    (let parsed (convert.parse-float64 "1.25"))
    (match parsed
      (result.result.ok 1.25) (test.assert true)
      _ (test.fail "float round trip failed"))
    (let infinity (convert.parse-float64 "inf"))
    (match infinity
      (result.result.ok (bind value))
        (test.assert-eq-str (convert.format-float64 value) "inf")
      _ (test.fail "infinity contract failed"))))
(test.scenario
  "boolean-is-exact"
  (test.case
    "boolean-is-exact"
    profile: @core
    (let parsed (convert.parse-bool "true"))
    (match parsed
      (result.result.ok true) (test.assert-eq-str (convert.format-bool false) "false")
      _ (test.fail "bool conversion failed"))))

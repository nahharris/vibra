(import test "../stdlib/src/test.vib")
(import random "../stdlib/src/random.vib")
(test.scenario
  "bytes-uses-the-random-source"
  (test.case
    "bytes-uses-the-random-source"
    profile: @random
    tags: (@stdlib)
    (let value (random.generate.bytes 8))
    (let raw (cast value (array uint8)))
    (match raw
      (array _ _ _ _ _ _ _ _) (test.assert true)
      _ (test.fail "random bytes returned the wrong length"))))

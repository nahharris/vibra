(import test "../stdlib/src/test.vib")
(test.scenario
  "literal-int-arm"
  (test.case
    "literal-int-arm"
    profile: @core
    (let n 3)
    (match n
      1 (test.fail "matched 1")
      3 (test.assert true)
      _ (test.fail "fell through to wildcard"))))
(test.scenario
  "literal-string-arm"
  (test.case
    "literal-string-arm"
    profile: @core
    (let s "b")
    (match s
      "a" (test.fail "matched a")
      "b" (test.assert true)
      _ (test.fail "fell through"))))
(test.scenario
  "bool-arm"
  (test.case
    "bool-arm"
    profile: @core
    (let flag false)
    (match flag
      true (test.fail "matched true")
      false (test.assert true)
      _ (test.fail "fell through bool match"))))
(test.scenario
  "wildcard-catch-all"
  (test.case
    "wildcard-catch-all"
    profile: @core
    (let n 99)
    (match n
      0 (test.fail "matched 0")
      _ (test.assert true))))
(test.scenario
  "bind-captures-value"
  (test.case
    "bind-captures-value"
    profile: @core
    (let n 8)
    (match n
      7 (test.fail "matched 7")
      (bind captured)
        (match captured
          8 (test.assert true)
          _ (test.fail "wrong captured value"))
      _ (test.fail "fell through to wildcard"))))

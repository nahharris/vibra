(import test "../stdlib/src/test.vib")
(defn ready () bool
  (return true))
(defn echo-bool (subject bool) bool
  (return subject))
(defn second (a bool b bool) bool
  (return b))
(defn check () bool
  (let r (ready))
  (return r))
(deffect
  owned
  (defn ping () void
    effects: ()
    (let _ true)))
(defn private-leaf () bool
  visibility: @private
  (owned.ping)
  (return true))
(defn private-middle () bool
  visibility: @private
  (let ready (private-leaf))
  (return ready))
(test.scenario
  "zero-arg-call"
  (test.case "zero-arg-call" profile: @core (let v (ready)) (test.assert v)))
(test.scenario
  "single-arg-call"
  (test.case "single-arg-call" profile: @core (let v (echo-bool true)) (test.assert v)))
(test.scenario
  "multi-arg-call"
  (test.case
    "multi-arg-call"
    profile: @core
    (let v (second false true))
    (test.assert v)))
(test.scenario
  "nested-call"
  (test.case "nested-call" profile: @core (let v (check)) (test.assert v)))
(test.scenario
  "private-effect-chain"
  (test.case
    "private-effect-chain"
    profile: @core
    (let v (private-middle))
    (test.assert v)))

(import assert @std.assert)

(import count @stats.count)

(test "words are runs of non-whitespace"
  (assert.equal 3u64 (count.count-words "  one two\tthree ")))

(test "an empty line has no words" (assert.equal 0u64 (count.count-words "")))

(test "a document is summarized line by line"
  (assert.equal
    (count.summary lines: 2u64 words: 5u64 longest: 13u64)
    (count.summarize "the quick fox\njumps over\n")))

(test "an empty document has no lines"
  (assert.equal
    (count.summary lines: 0u64 words: 0u64 longest: 0u64)
    (count.summarize "")))

(test "the report lists each count"
  (assert.equal
    "lines: 1\nwords: 2\nlongest: 9\n"
    (count.render (count.summary lines: 1u64 words: 2u64 longest: 9u64))))

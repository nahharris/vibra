{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vibra:schema:v1:command-result",
  "title": "Vibra command result",
  "description": "One versioned result envelope emitted by the vibra process.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "command", "result", "diagnostics", "payload"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "command": {
      "enum": ["help", "init", "fmt", "check", "run", "test", "inspect", "add", "remove", "sync", "lint", "build", "query", "edit", "mcp", "invalid", "codebase-init", "codebase-head", "codebase-import", "codebase-lookup", "codebase-read", "codebase-export", "codebase-verify", "codebase-reindex", "codebase-backup", "codebase-restore"]
    },
    "result": {
      "enum": [
        "@command.ok",
        "@command.diagnostics",
        "@command.test-failed",
        "@command.invalid-input",
        "@command.operational-failure",
        "@command.trap",
        "@command.unavailable",
        "@command.program-failed"
      ]
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-init"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "store"
                  ],
                  "properties": {
                    "store": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-head"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "head",
                    "revision"
                  ],
                  "properties": {
                    "head": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-import"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "head",
                    "revision",
                    "published",
                    "objectCount",
                    "sourceCount"
                  ],
                  "properties": {
                    "head": {
                      "type": "string"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "published": {
                      "type": "boolean"
                    },
                    "objectCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sourceCount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-lookup"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "revision",
                    "entity",
                    "object",
                    "part"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "entity": {
                      "type": "string",
                      "minLength": 1
                    },
                    "object": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "part": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-read"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "revision",
                    "object",
                    "component",
                    "memberIndex",
                    "payload",
                    "references"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "object": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "component": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "memberIndex": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "payload": {
                      "type": "string",
                      "minLength": 1
                    },
                    "references": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "part",
                          "kind",
                          "target"
                        ],
                        "properties": {
                          "part": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "minLength": 1
                            }
                          },
                          "kind": {
                            "enum": ["value-reference", "type-reference", "contract", "implementation", "effect-owner", "initializer", "call"]
                          },
                          "target": {
                            "oneOf": [
                              {
                                "type": "string",
                                "pattern": "^sha256:[0-9a-f]{64}$"
                              },
                              {
                                "type": "integer",
                                "minimum": 0
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["kind", "identity", "registry"],
                                "properties": {
                                  "kind": { "const": "@trusted-external" },
                                  "identity": { "type": "string", "pattern": "^@(compiler|host):.+$" },
                                  "registry": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                                }
                              }
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-export"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "revision",
                    "destination",
                    "plan",
                    "files",
                    "written"
                  ],
                  "properties": {
                    "revision": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "destination": {
                      "type": "string"
                    },
                    "plan": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    },
                    "files": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "path",
                          "sourceHash",
                          "byteLength"
                        ],
                        "properties": {
                          "path": {
                            "type": "string",
                            "minLength": 1
                          },
                          "sourceHash": {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          },
                          "byteLength": {
                            "type": "integer",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "written": {
                      "type": "boolean"
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-verify"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "valid",
                    "revisionCount",
                    "objectCount",
                    "sourceCount"
                  ],
                  "properties": {
                    "valid": {
                      "const": true
                    },
                    "revisionCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "objectCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sourceCount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-reindex"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "revisionCount",
                    "entityCount",
                    "edgeCount"
                  ],
                  "properties": {
                    "revisionCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "entityCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "edgeCount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-backup"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "destination",
                    "revisionCount"
                  ],
                  "properties": {
                    "destination": {
                      "type": "string"
                    },
                    "revisionCount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "const": "codebase-restore"
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "@command.ok",
              "@command.operational-failure",
              "@command.diagnostics",
              "@command.invalid-input"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "result": {
                  "const": "@command.ok"
                }
              }
            },
            "then": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "store",
                    "revisionCount",
                    "objectCount",
                    "sourceCount"
                  ],
                  "properties": {
                    "store": {
                      "type": "string"
                    },
                    "revisionCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "objectCount": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "sourceCount": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "payload": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [],
                  "properties": {}
                }
              }
            }
          }
        ]
      }
    },
    {
      "description": "A program failure is an entry that returned err: only run ends so, with the encoding of the result, no trap, and no diagnostic.",
      "if": { "properties": { "result": { "const": "@command.program-failed" } } },
      "then": {
        "properties": {
          "command": { "const": "run" },
          "diagnostics": { "maxItems": 0 },
          "payload": {
            "properties": {
              "programResult": { "type": "string", "minLength": 1 },
              "trap": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "init" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["workspace", "created"],
            "properties": {
              "workspace": { "type": "string", "minLength": 1 },
              "created": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "fmt" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "changed", "written", "text"],
            "properties": {
              "path": { "type": "string" },
              "changed": { "type": "boolean" },
              "written": { "type": "boolean" },
              "text": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "check" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["accepted"],
            "properties": { "accepted": { "type": "boolean" } }
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "run" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "programResult", "stdout", "stderr", "auditTrace", "trap"],
            "properties": {
              "target": { "type": "string" },
              "programResult": { "type": ["string", "null"] },
              "stdout": { "type": "string" },
              "stderr": { "type": "string" },
              "auditTrace": { "type": "array", "items": { "$ref": "#/$defs/auditEvent" } },
              "trap": {
                "oneOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["trapCode", "origin"],
                    "properties": {
                      "trapCode": { "$ref": "#/$defs/trapCode" },
                      "origin": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/span" }] }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "help" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["usage"],
            "properties": { "usage": { "type": "string", "minLength": 1 } }
          }
        }
      }
    },
    {
      "if": { "properties": { "command": { "const": "test" } } },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["selected", "passed", "failed", "tests"],
            "properties": {
              "selected": { "type": "integer", "minimum": 0 },
              "passed": { "type": "integer", "minimum": 0 },
              "failed": { "type": "integer", "minimum": 0 },
              "tests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "result", "failure", "trap", "auditTrace", "diagnostics"],
                  "properties": {
                    "name": { "type": "string" },
                    "result": {
                      "enum": [
                        "@test.passed",
                        "@test.assertion-failed",
                        "@test.invalid",
                        "@test.unavailable",
                        "@test.trap"
                      ]
                    },
                    "failure": {
                      "oneOf": [
                        { "type": "null" },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["assertion", "expected", "actual", "primarySpan"],
                          "properties": {
                            "assertion": {
                              "type": "string",
                              "pattern": "^@std\\.assert\\.(true|false|equal)$"
                            },
                            "expected": { "type": "string" },
                            "actual": { "type": "string" },
                            "primarySpan": { "$ref": "#/$defs/span" }
                          }
                        }
                      ]
                    },
                    "trap": {
                      "oneOf": [
                        { "type": "null" },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": ["trapCode", "origin"],
                          "properties": {
                            "trapCode": { "$ref": "#/$defs/trapCode" },
                            "origin": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/span" }] }
                          }
                        }
                      ]
                    },
                    "auditTrace": { "type": "array", "items": { "$ref": "#/$defs/auditEvent" } },
                    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } }
                  },
                  "allOf": [
                    {
                      "if": { "properties": { "result": { "const": "@test.assertion-failed" } } },
                      "then": {
                        "properties": {
                          "failure": { "type": "object" },
                          "trap": { "type": "null" }
                        }
                      },
                      "else": { "properties": { "failure": { "type": "null" } } }
                    },
                    {
                      "if": { "properties": { "result": { "const": "@test.trap" } } },
                      "then": {
                        "properties": {
                          "trap": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["trapCode", "origin"],
                            "properties": {
                              "trapCode": { "$ref": "#/$defs/trapCode" },
                              "origin": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/span" }] }
                            }
                          },
                          "failure": { "type": "null" }
                        }
                      },
                      "else": { "properties": { "trap": { "type": "null" } } }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "command": {
            "enum": ["inspect", "add", "remove", "sync", "lint", "build", "query", "edit", "mcp", "invalid"]
          }
        }
      },
      "then": {
        "properties": {
          "payload": { "type": "object", "maxProperties": 0 }
        }
      }
    }
  ],
  "$defs": {
    "trapCode": {
      "description": "The closed trap codes of the runtime chapter.",
      "enum": [
        "@runtime.invalid-checked-program",
        "@runtime.unobservable-function",
        "@runtime.invalid-host-value",
        "@runtime.division-by-zero"
      ]
    },
    "auditEvent": {
      "description": "One completed host call of the audit trace. A host event is closed; an event of a kind this schema does not know keeps its field names and carries every value as text, so a consumer preserves it.",
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "pattern": "^@[a-z][a-z0-9-]*$" }
      },
      "if": { "properties": { "kind": { "const": "@host" } } },
      "then": {
        "additionalProperties": false,
        "required": ["kind", "op", "args", "result"],
        "properties": {
          "kind": { "const": "@host" },
          "op": { "type": "string", "minLength": 1 },
          "args": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "result": { "type": "string", "minLength": 1 }
        }
      },
      "else": { "additionalProperties": { "type": "string" } }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "start", "end", "startPosition", "endPosition"],
      "properties": {
        "sourceId": { "type": ["string", "null"], "minLength": 1 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 },
        "startPosition": { "$ref": "#/$defs/position" },
        "endPosition": { "$ref": "#/$defs/position" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "code", "level", "message", "primarySpan", "related", "notes", "fixes"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "code": { "type": "string", "pattern": "^@[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$" },
        "level": { "enum": ["@error", "@warning"] },
        "message": { "type": "string" },
        "primarySpan": { "$ref": "#/$defs/span" },
        "related": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["span", "message"],
            "properties": { "span": { "$ref": "#/$defs/span" }, "message": { "type": "string" } }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } },
        "fixes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "safe", "expectedRevision"],
            "properties": {
              "description": { "type": "string" },
              "safe": { "type": "boolean" },
              "expectedRevision": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}

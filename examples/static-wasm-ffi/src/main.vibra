foreign-sum:
  $function:
    left: $int32
  args:
    right: $int32
  return: $int32
  do:
    - $wasm:
        import:
          module: "@math"
          name: sum
        args: [$args.left, $args.right]

main:
  $function: $void
  return: $void
  do:
    - $let:
        answer:
          $foreign-sum:
            left: 20
            right: 22

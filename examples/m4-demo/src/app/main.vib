(import env @std.env)

(import fs @std.fs)

(import io @std.io)

(deftype usage (enum missing-path void))

(deftype demo-error (union usage env.env-error fs.fs-error io.io-error))

(defn quote (quoted str line str) str
  (str.concat quoted (str.concat "> " (str.concat line "\n"))))

(defn first-argument () (result str demo-error)
  effects: (env.read)
  (match
    (env.read.args)
    (result.ok found) (match
      (found 0u64)
      (option.some path) (result.ok path)
      (option.none) (result.err (demo-error (usage.missing-path))))
    (result.err cause) (result.err (demo-error cause))))

(defn read-file (path str) (result str demo-error)
  effects: (fs.read)
  (match
    (fs.read.text (fs.path path))
    (result.ok contents) (result.ok contents)
    (result.err cause) (result.err (demo-error cause))))

(defn write-out (output str) (result void demo-error)
  effects: (io.stdout)
  (match
    (io.stdout.text output)
    (result.ok) (result.ok)
    (result.err cause) (result.err (demo-error cause))))

; The M4 demo: reads the file named by the first program argument, quotes each
; of its lines, and writes the result to standard output. The entry declares
; each root it performs, and so does the target. No failure is swallowed: a
; missing argument, an unreadable file, and a failed write each end the run as an
; `err` of `demo-error`, which `vibra run` reports with exit code 6.
(defn main () (result void demo-error)
  effects: (env.read fs.read io.stdout)
  (let path (try (first-argument)))
  (let contents (try (read-file path)))
  (let lines (str.split (str.trim contents) "\n"))
  (write-out (array.fold lines "" quote)))

; Parses `key = value` lines into typed entries. Blank lines and lines starting
; with `#` are skipped; every failure names its 1-based line.
(import classes @std.char)

(import text @std.text)

(deftype value (enum integer i64 flag bool word str) visibility: @public)

(deftype entry (record key str value value) visibility: @public)

(deftype missing-separator (record line u64) visibility: @public)

(deftype empty-key (record line u64) visibility: @public)

(deftype bad-integer (record line u64 text str) visibility: @public)

(deftype parse-error (union missing-separator empty-key bad-integer)
  visibility: @public)

(defn parse (source str) (result (array entry) parse-error)
  visibility: @public
  (parse-lines (text.split source "\n") 0u64 (array.of)))

(defn parse-lines (lines (array str) index u64 entries (array entry))
  (result (array entry) parse-error)
  (match
    (lines index)
    (option.none) (result.ok entries)
    (option.some raw) (do
      (let line (text.trim raw))
      (let number (after index))
      (if
        (skipped line)
        (parse-lines lines number entries)
        (parse-lines
          lines
          number
          (array.append entries (try (parse-entry line number))))))))

(defn skipped (line str) bool
  (if (text.equal line "") true (text.starts-with line "#")))

(defn parse-entry (line str number u64) (result entry parse-error)
  (match
    (text.index-of line "=")
    (option.none) (result.err (parse-error (missing-separator line: number)))
    (option.some at) (do
      (let key (text.trim (part line 0u64 at)))
      (let raw (text.trim (part line (after at) (text.length line))))
      (if
        (text.equal key "")
        (result.err (parse-error (empty-key line: number)))
        (result.ok (entry key: key value: (try (parse-value raw number))))))))

(defn parse-value (raw str number u64) (result value parse-error)
  (match
    raw
    "true" (result.ok (value.flag true))
    "false" (result.ok (value.flag false))
    - (if
      (numeric raw)
      (match
        (i64.parse raw)
        (result.ok integer) (result.ok (value.integer integer))
        (result.err -) (result.err (parse-error (bad-integer line: number text: raw))))
      (result.ok (value.word raw)))))

; A value that starts like an integer is read as one.
(defn numeric (raw str) bool
  (match
    ((text.to-chars raw) 0u64)
    (option.some first) (if (classes.is-ascii-digit first) true (classes.equal first \-))
    (option.none) false))

(defn part (line str start u64 end u64) str
  (match (text.slice line start end) (option.some piece) piece (option.none) ""))

(defn after (index u64) u64
  (match (u64.add-checked index 1u64) (result.ok next) next (result.err -) index))

(import io "../stdlib/src/io.vib")
(import fs "../stdlib/src/fs.vib")
(import result "../stdlib/src/result.vib")
(import stream "../stdlib/src/stream.vib")
(defn
  main
  ()
  void
  (let path (fs.path.new "tmp/hello.txt"))
  (let opened-write (fs.write.open path))
  (match
    opened-write
    (result.result.ok (bind out))
    (do
      (match
        (stream.write.string out "from vibra fs")
        (result.result.ok)
        (do)
        (result.result.err _)
        (do (io.stderr.println "failed to write file"))
      )
      (match
        (stream.manage.close out)
        (result.result.ok)
        (do)
        (result.result.err _)
        (do (io.stderr.println "failed to close file"))
      )
    )
    (result.result.err _)
    (do (io.stderr.println "failed to open file for writing"))
  )
  (let opened-read (fs.read.open path))
  (match
    opened-read
    (result.result.ok (bind input))
    (do
      (let text-result (stream.read.string input))
      (match
        text-result
        (result.result.ok (bind text))
        (io.stdout.println text)
        (result.result.err _)
        (io.stderr.println "failed to read file")
      )
      (match
        (stream.manage.close input)
        (result.result.ok)
        (do)
        (result.result.err _)
        (do (io.stderr.println "failed to close file"))
      )
    )
    (result.result.err _)
    (do (io.stderr.println "failed to open file for reading"))
  )
)

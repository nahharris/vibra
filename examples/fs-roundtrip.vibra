(import io "../stdlib/src/io.vibra")
(import fs "../stdlib/src/fs.vibra")
(import result "../stdlib/src/result.vibra")
(defn
  main
  ()
  void
  (let path (fs.path.new "tmp/hello.txt"))
  (let opened-write (fs.open-write path))
  (match
    opened-write
    (result.result.ok (bind out))
    (do (fs.writable.write-string out "from vibra fs") (fs.closeable.close out))
    (result.result.err (bind write-err))
    (do (io.eprintln "failed to open file for writing"))
  )
  (let opened-read (fs.open-read path))
  (match
    opened-read
    (result.result.ok (bind input))
    (do
      (let text-result (fs.readable.read-string input))
      (match
        text-result
        (result.result.ok (bind text))
        (io.println text)
        (result.result.err (bind read-err))
        (io.eprintln "failed to read file")
      )
      (fs.closeable.close input)
    )
    (result.result.err (bind open-err))
    (do (io.eprintln "failed to open file for reading"))
  )
)

(import io "../stdlib/src/io.vibra")
(import fs "../stdlib/src/fs.vibra")
(import result "../stdlib/src/result.vibra")
(import stream "../stdlib/src/stream.vibra")
(defn
  main
  ()
  void
  (let path (fs.path.new "tmp/hello.txt"))
  (let opened-write (fs.write.open path))
  (match
    opened-write
    (result.result.ok (bind out))
    (do (stream.write.string out "from vibra fs") (stream.manage.close out))
    (result.result.err (bind write-err))
    (do (io.stderr.println "failed to open file for writing"))
  )
  (let opened-read (fs.read.open path))
  (match
    opened-read
    (result.result.ok (bind input))
    (do
      (let text-result (stream.read.string input))
      (match
        text-result
        (result.result.ok (bind text))
        (io.stdout.println text)
        (result.result.err (bind read-err))
        (io.stderr.println "failed to read file")
      )
      (stream.manage.close input)
    )
    (result.result.err (bind open-err))
    (do (io.stderr.println "failed to open file for reading"))
  )
  effects: (fs.read fs.write io.stdout io.stderr stream.read stream.write stream.manage)
)

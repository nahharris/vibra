(import io "../stdlib/src/io.vib")
(import result "../stdlib/src/result.vib")
(defn
  main
  ()
  void
  (io.stdout.print "What is your name? ")
  (let name-result (io.stdin.readln))
  (match
    name-result
    (result.result.ok (bind name))
    (do (io.stdout.println name))
    (result.result.err (bind err))
    (do (io.stderr.println "failed to read stdin"))
  )
)

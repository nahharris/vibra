io:
  $import: ../stdlib/src/io.vibra
result:
  $import: ../stdlib/src/result.vibra
main:
  $function:
    policy:
      $policy:
        stdin-read:
        - requirement: mandatory
          scopes: any
  return: $void
  do:
  - $io.print: 'What is your name? '
  - $let:
      stdin:
        $policy.narrow: $args.policy
        into: $io.stdin-capability
  - $let:
      name-result:
        $io.readln:
          capability: $stdin
  - $match: $name-result
    when:
    - case:
        $result.result.ok:
          $bind: name
      do:
      - $io.println: $name
    - case:
        $result.result.err:
          $bind: err
      do:
      - $io.eprintln: failed to read stdin

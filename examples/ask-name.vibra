(import io "../stdlib/src/io.vibra")
(import result "../stdlib/src/result.vibra")
(fn
  main
  ((policy (policy (stdin-read (group requirement: mandatory scopes: ((any)))))))
  void
  (do
    (io.print "What is your name? ")
    (let stdin (policy.narrow policy io.stdin-capability))
    (let name-result (io.readln stdin))
    (match
      name-result
      (case (result.result.ok (bind name)) (do (io.println name)))
      (case
        (result.result.err (bind err))
        (do (io.eprintln "failed to read stdin"))
      )
    )
  )
)

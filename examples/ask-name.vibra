(import io "../stdlib/src/io.vibra")
(import result "../stdlib/src/result.vibra")
(import effects "../stdlib/src/effects.vibra")
(defn
  main
  ()
  void
  (io.print "What is your name? ")
  (let name-result (io.readln))
  (match
    name-result
    (result.result.ok (bind name))
    (do (io.println name))
    (result.result.err (bind err))
    (do (io.eprintln "failed to read stdin"))
  )
  effects: (effects.io-write effects.io-read)
)

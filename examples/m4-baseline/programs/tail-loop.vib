; A tail loop of a million iterations: every call of `spin` is in tail position,
; so the loop runs in constant depth and, in a module, in constant arena.
(defn main () u64 (spin 1000000u64 0u64))

(defn spin (remaining u64 total u64) u64
  (if (equatable.equal remaining 0u64)
    total
    (spin (lower remaining) (bump total))))

(defn lower (count u64) u64
  (match (u64.sub-checked count 1u64)
    (result.ok value) value
    (result.err -) 0u64))

(defn bump (count u64) u64
  (match (u64.add-checked count 1u64)
    (result.ok value) value
    (result.err -) 0u64))

; Two thousand concatenations onto one growing text, then its length.

(defn main () u64 (str.length (grow 2000u64 "")))

(defn grow (remaining u64 acc str) str
  (if (equatable.equal remaining 0u64)
    acc
    (grow (lower remaining) (str.concat acc "ab"))))

(defn lower (count u64) u64
  (match (u64.sub count 1u64)
    (result.ok value) value
    (result.err -) 0u64))

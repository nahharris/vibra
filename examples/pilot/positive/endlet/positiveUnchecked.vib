type PositiveError
  case nonPositive
  visibility @public
endtype

type Positive of I32
  where isPositive
  visibility @public
endtype

fn isPositive
  takes {value: I32}
  returns ok: Bool
  visibility @public
  do
    return Ordered.greater(value 0i32)
endfn

fn makePositive
  takes {raw: I32}
  returns made: Result(Positive PositiveError)
  visibility @public
  do
    return Result.ok(value: Positive(raw))
endfn

fn readPositive
  takes {Positive(inner): Positive}
  returns value: I32
  ensures isPositive(value)
  visibility @public
  do
    return inner
endfn

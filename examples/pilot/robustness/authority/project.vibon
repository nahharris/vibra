{
  format: @project.v2
  package: {name: "pilot" version: "0.1.0"}
  targets: [
    {name: @pilot kind: @lib root: "src/pilot"}
    {
      name: @grab
      kind: @bin
      root: "src/grab"
      entry: @grab.main.main
      effects: [@std.fs.DirReadText]
      grants: [
        @home: {
          provider: @host.fs.directory
          resource: {kind: @fixedPath path: ""}
          policy: {
            format: @scopePolicy.v1
            family: @filesystem
            expression: {
              kind: @fileRule
              root: @home
              prefix: []
              depth: @tree
              actions: [@read]
              names: {kind: @anyName}
            }
          }
          after: []
        }
      ]
    }
  ]
  dependencies: [:]
}

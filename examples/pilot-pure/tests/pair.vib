use @std.assert enduse

use @pilot.pair enduse

test "a reversed pair is ordered with its delta"
  do
    assert.equal(
      {first: 3i32 second: 8i32 delta: Option.some(value: 5i32)}
      pair.normalizePair({low: 8i32 high: 3i32})
    )
endtest

test "the delta can be left out"
  do
    assert.equal(
      {first: 3i32 second: 8i32 delta: Option.none()}
      pair.normalizePair({low: 8i32 high: 3i32} includeDelta: false)
    )
endtest

test "equal bounds have a delta of zero"
  do
    assert.equal(
      {first: 4i32 second: 4i32 delta: Option.some(value: 0i32)}
      pair.normalizePair({low: 4i32 high: 4i32})
    )
endtest

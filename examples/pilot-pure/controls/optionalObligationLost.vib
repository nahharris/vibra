fn mapOptional(A B)
  takes {item: Option(A) f: Fn({A} B)}
  returns mapped: Option(B)
  do
    return match item
      case Option.some(value: value)
        Option.some(value: f(value))
      case Option.none()
        Option.none()
    endmatch
endfn

fn strictPositive
  takes {value: I32}
  returns same: I32
  requires Ordered.greater(value 0i32)
  do
    return value
endfn

fn lost
  takes {item: Option(I32)}
  returns mapped: Option(I32)
  do
    return mapOptional(item strictPositive)
endfn

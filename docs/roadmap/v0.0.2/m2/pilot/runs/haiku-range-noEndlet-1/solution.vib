type RangeError
  case invalid
  visibility @public
endtype

type Range of {low: I32 high: I32}
  where orderedRange else RangeError.invalid()
  visibility @public
endtype

fn orderedRange
  takes {bounds: {low: I32 high: I32}}
  returns ok: Bool
  do
    return Ordered.lessOrEqual(bounds.low bounds.high)
endfn

fn makeRange
  takes {low: I32 high: I32}
  returns made: Result(Range RangeError)
  visibility @public
  do
    return Range(low: low high: high)
endfn

fn spanOr
  takes {low: I32 high: I32 fallback: I32}
  returns width: I32
  visibility @public
  do
    return match makeRange(low high)
      case Result.ok(value: current)
        I32.sub(current.high current.low)
      case Result.err(error: _)
        fallback
    endmatch
endfn

let reversed: Result(Range RangeError) be Range(low: 5i32 high: 2i32)

fn reversedSpanOr
  takes {fallback: I32}
  returns width: I32
  visibility @public
  do
    return match reversed
      case Result.ok(value: current)
        I32.sub(current.high current.low)
      case Result.err(error: _)
        fallback
    endmatch
endfn

// Orders a pair of integers and reports the gap between them.
fn normalizePair
  takes {{low: lo high: hi}: {low: I32 high: I32}}
  labelled {includeDelta: Bool be true}
  returns pair: {first: I32 second: I32 delta: Option(I32)}
  visibility @public
  do
    let first: I32 be if Ordered.lessOrEqual(lo hi) then lo else hi endif endlet
    let second: I32 be if Ordered.lessOrEqual(lo hi) then hi else lo endif endlet
    let delta: Option(I32) be
      if includeDelta then
        Option.some(value: I32.sub(second first))
      else
        Option.none()
      endif
    endlet
    return {first: first second: second delta: delta}
endfn

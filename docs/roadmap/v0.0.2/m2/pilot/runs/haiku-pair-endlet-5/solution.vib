fn normalizePair
  takes {{low: lowest high: highest}: {low: I32 high: I32}}
  labelled {includeDelta: Bool be true}
  returns pair: {first: I32 second: I32 delta: Option(I32)}
  visibility @public
  do
    let first: I32 be if Ordered.less(highest lowest) then highest else lowest endif endlet
    let second: I32 be if Ordered.less(highest lowest) then lowest else highest endif endlet
    let delta: Option(I32) be
      if includeDelta then
        Option.some(value: I32.sub(second first))
      else
        Option.none()
      endif
    endlet
    return {first: first second: second delta: delta}
endfn

type Row of {key: Str amount: I32}
  visibility @public
endtype

fn indexRows
  takes {rows: List(Row)}
  returns index: Dict(Str I32)
  visibility @public
  do
    let pairs: List({Str I32}) be
      Iter.collect(
        Iter.map(
          rows
          fn
            takes {row: Row}
            returns pair: {Str I32}
            do
              return {row.key row.amount}
          endfn
        )
      )
    endlet
    return From.convert(pairs)
endfn

fn latest
  takes {rows: List(Row) key: Str}
  returns amount: Option(I32)
  visibility @public
  do
    let table be indexRows(rows) endlet
    return table(key)
endfn

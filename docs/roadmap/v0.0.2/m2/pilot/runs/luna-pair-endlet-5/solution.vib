fn normalizePair
  takes {{low high}: {low: I32 high: I32}}
  labelled {includeDelta: Bool be true}
  returns pair: {first: I32 second: I32 delta: Option(I32)}
  visibility @public
  do
    let {first second} be if Ordered.less(low high) then
      {first: low second: high}
    else
      {first: high second: low}
    endif endlet
    let delta be if includeDelta then
      Option.some(value: I32.sub(second first))
    else
      Option.none()
    endif endlet
    return {first: first second: second delta: delta}
endfn
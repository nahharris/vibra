(import test "../stdlib/src/test.vib")
(import option "../stdlib/src/option.vib")
(test.scenario
  "some-carries-payload"
  (test.case
    "some-carries-payload"
    profile: @core
    (let o (option.option.some 7))
    (match o
      (option.option.some (bind v))
        (match v
          7 (test.assert true)
          _ (test.fail "wrong some payload"))
      (option.option.none) (test.fail "expected some"))))
(test.scenario
  "none-variant"
  (test.case
    "none-variant"
    profile: @core
    (let present (option.option.some 1))
    (match present
      (option.option.some _) (do
        (let absent option.option.none)
        (match absent
          (option.option.some _) (test.fail "expected none")
          (option.option.none) (test.assert true)))
      (option.option.none) (test.fail "expected some"))))
(test.scenario
  "queries-and-defaulting"
  (test.case
    "queries-and-defaulting"
    profile: @core
    (let present (option.option.some 7))
    (test.assert (option.is-some int64 present))
    (let present-value (option.unwrap-or int64 present 11))
    (match present-value
      7 (test.assert true)
      _ (test.fail "some did not preserve its value"))))
(test.scenario
  "and-or-combinators"
  (test.case
    "and-or-combinators"
    profile: @core
    (let present (option.from-value int64 1))
    (let absent (option.empty int64 false))
    (let next (option.from-value str "next"))
    (match (option.and int64 str present next)
      (option.option.some "next")
        (match (option.or int64 absent present)
          (option.option.some 1) (test.assert true)
          _ (test.fail "option or did not select fallback"))
      _ (test.fail "option and did not select next"))))

test:
  $import: ../stdlib/src/test.vibra
env:
  $import: ../stdlib/src/env.vibra
result:
  $import: ../stdlib/src/result.vibra
get-reads-an-explicitly-granted-variable:
  $test: env
  tags:
  - stdlib
  - capability
  policy:
    $policy:
      env-read:
      - requirement: mandatory
        scopes:
        - exact: PATH
  do:
  - $let:
      capability:
        $policy.narrow: $args.policy
        into: $env.read-capability
  - $let:
      value:
        $env.get: PATH
        capability: $capability
  - $match: $value
    when:
    - case:
        $result.result.ok:
          $wildcard: null
      do:
      - $test.assert: true
    - case:
        $result.result.err:
          $wildcard: null
      do:
      - $test.fail: granted environment variable was not readable

(import test "../stdlib/src/test.vibra")
(import random "../stdlib/src/random.vibra")
(import time "../stdlib/src/time.vibra")
(test
  typed-equality-helpers
  core
  (do
    (test.assert-eq-bool true true)
    (test.assert-eq-int 42 42)
    (test.assert-eq-float 1.5 1.5)
    (test.assert-eq-str "vibra" "vibra")
  )
)
(test
  seeded-random-and-fake-clock
  core
  (do
    (let random-capability (policy.narrow policy random.capability))
    (let clock-capability (policy.narrow policy time.capability))
    (let value (random.bytes 8 random-capability))
    (let raw (cast value (array uint8)))
    (match
      raw
      (case (array 149 110 235 47 38 50 215 189) (do (test.assert true)))
      (case _ (do (test.fail "seeded random sequence changed")))
    )
    (let wall (time.now-unix-millis clock-capability))
    (match
      wall
      (case 1000 (do (test.assert true)))
      (case _ (do (test.fail "fake wall clock did not use fixture")))
    )
    (let before (time.monotonic-now clock-capability))
    (time.sleep (time.milliseconds 7) clock-capability)
    (let after (time.monotonic-now clock-capability))
    (let before-raw (cast before uint64))
    (let after-raw (cast after uint64))
    (match
      before-raw
      (case
        40
        (do
          (match
            after-raw
            (case 47 (do (test.assert true)))
            (case _ (do (test.fail "fake monotonic clock did not advance")))
          )
        )
      )
      (case _ (do (test.fail "fake monotonic clock did not use fixture")))
    )
  )
  random-seed: 42
  clock: (fixed 1000 40)
  policy: (policy
    (clock (group requirement: mandatory scopes: ((any))))
    (random (group requirement: mandatory scopes: ((any))))
  )
)

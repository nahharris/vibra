(import test "../stdlib/src/test.vib")
(import io "../stdlib/src/io.vib")
(import result "../stdlib/src/result.vib")
(test.scenario
  "print-statement-runs"
  (test.case
    "print-statement-runs"
    (let r (io.stdout.print "stdout from vibra test"))
    (match
      r
      (result.result.ok)
      (do (test.assert true))
      (result.result.err _)
      (do (test.fail "print returned err"))
    )
    profile: @core
  )
)
(test.scenario
  "println-returns-ok"
  (test.case
    "println-returns-ok"
    (let r (io.stdout.println "line from vibra test"))
    (match
      r
      (result.result.ok)
      (do (test.assert true))
      (result.result.err _)
      (do (test.fail "println returned err"))
    )
    profile: @core
  )
)
(test.scenario
  "eprintln-statement-runs"
  (test.case
    "eprintln-statement-runs"
    (let r (io.stderr.println "stderr from vibra test"))
    (match
      r
      (result.result.ok)
      (do (test.assert true))
      (result.result.err _)
      (do (test.fail "eprintln returned err"))
    )
    profile: @core
  )
)

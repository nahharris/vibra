(import test "../stdlib/src/test.vib")
(import result "../stdlib/src/result.vib")
(import option "../stdlib/src/option.vib")

(defn result-success-through-try
  ()
  (result.result int64 str)
  (let value (try (result.from-ok int64 str 17)))
  (return (result.from-ok int64 str value))
)

(defn result-error-through-try
  ()
  (result.result int64 str)
  (let value (try (result.from-err int64 str "boom")))
  (return (result.from-ok int64 str value))
)

(defn option-some-through-try
  ()
  (option.option int64)
  (let value (try (option.from-value int64 23)))
  (return (option.from-value int64 value))
)

(defn option-none-through-try
  ()
  (option.option int64)
  (let value (try (option.empty int64 false)))
  (return (option.from-value int64 value))
)

(test.scenario
  "result-success-unwrapping"
  (test.case
    "result-success-unwrapping"
    (let actual (result-success-through-try))
    (match
      actual
      (result.result.ok (bind value))
      (test.assert-eq-int value 17)
      _
      (test.fail "try did not unwrap result success")
    )
    profile: @core
  )
)

(test.scenario
  "result-error-propagation"
  (test.case
    "result-error-propagation"
    (let actual (result-error-through-try))
    (match
      actual
      (result.result.err (bind error))
      (test.assert-eq-str error "boom")
      _
      (test.fail "try did not propagate result error")
    )
    profile: @core
  )
)

(test.scenario
  "option-some-unwrapping"
  (test.case
    "option-some-unwrapping"
    (let actual (option-some-through-try))
    (match
      actual
      (option.option.some (bind value))
      (test.assert-eq-int value 23)
      _
      (test.fail "try did not unwrap option some")
    )
    profile: @core
  )
)

(test.scenario
  "option-none-propagation"
  (test.case
    "option-none-propagation"
    (let actual (option-none-through-try))
    (match
      actual
      (option.option.none)
      (test.assert true)
      _
      (test.fail "try did not propagate option none")
    )
    profile: @core
  )
)

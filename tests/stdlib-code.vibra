test:
  $import: ../stdlib/test.vibra
code:
  $import: ../stdlib/code.vibra
path-lookup-returns-structural-node:
  $test: core
  do:
    - $let:
        parsed:
          $code.parse: |
            greeting: hi
    - $match: $parsed
      when:
      - case:
          $code.document-result.ok:
            $bind: document
        do:
        - $let:
            found:
              $code.at: $document
              path:
                $array:
                - $code.segment.key: greeting
        - $match: $found
          when:
          - case:
              $code.node-result.ok:
                $bind: node
            do:
            - $let:
                source:
                  $code.source: $node
            - $match: $source
              when:
              - case: hi
                do:
                - $test.assert: true
              - case:
                  $wildcard: null
                do:
                - $test.fail: expected structural scalar source
          - case:
              $code.node-result.err:
                $bind: error
            do:
            - $test.fail: path lookup failed
      - case:
          $code.document-result.err:
            $bind: error
        do:
        - $test.fail: parse failed
replace-form-preserves-document-comments:
  $test: core
  do:
    - $let:
        parsed:
          $code.parse: |
            =comment: keep
            greeting: hi
    - $match: $parsed
      when:
      - case:
          $code.document-result.ok:
            $bind: document
        do:
        - $let:
            found:
              $code.at: $document
              path:
                $array:
                - $code.segment.key: greeting
        - $match: $found
          when:
          - case:
              $code.node-result.ok:
                $bind: node
            do:
            - $let:
                changed:
                  $code.replace: $document
                  target: $node
                  value:
                    $code.form.string: changed
            - $match: $changed
              when:
              - case:
                  $code.document-result.ok:
                    $bind: output
                do:
                - $let:
                    rendered:
                      $code.emit: $output
                - $match: $rendered
                  when:
                  - case: |
                      =comment: keep
                      greeting: changed
                    do:
                    - $test.assert: true
                  - case:
                      $wildcard: null
                    do:
                    - $test.fail: replacement lost source trivia
              - case:
                  $code.document-result.err:
                    $bind: error
                do:
                - $test.fail: replacement failed
          - case:
              $code.node-result.err:
                $bind: error
            do:
            - $test.fail: path lookup failed
      - case:
          $code.document-result.err:
            $bind: error
        do:
        - $test.fail: parse failed
mapping-upsert-is-structural:
  $test: core
  do:
    - $let:
        parsed:
          $code.parse: |
            config:
              enabled: false
    - $match: $parsed
      when:
      - case:
          $code.document-result.ok:
            $bind: document
        do:
        - $let:
            found:
              $code.at: $document
              path:
                $array:
                - $code.segment.key: config
        - $match: $found
          when:
          - case:
              $code.node-result.ok:
                $bind: node
            do:
            - $let:
                changed:
                  $code.upsert-mapping: $document
                  target: $node
                  key: enabled
                  value:
                    $code.form.bool: true
            - $match: $changed
              when:
              - case:
                  $code.document-result.ok:
                    $bind: output
                do:
                - $match:
                    $code.emit: $output
                  when:
                  - case: |
                      config:
                        enabled: true
                    do:
                    - $test.assert: true
                  - case:
                      $wildcard: null
                    do:
                    - $test.fail: mapping upsert rendered incorrectly
              - case:
                  $code.document-result.err:
                    $bind: error
                do:
                - $test.fail: mapping upsert failed
          - case:
              $code.node-result.err:
                $bind: error
            do:
            - $test.fail: path lookup failed
      - case:
          $code.document-result.err:
            $bind: error
        do:
        - $test.fail: parse failed
sequence-splice-is-structural:
  $test: core
  do:
    - $let:
        parsed:
          $code.parse: |
            items:
              - a
              - b
    - $match: $parsed
      when:
      - case:
          $code.document-result.ok:
            $bind: document
        do:
        - $let:
            found:
              $code.at: $document
              path:
                $array:
                - $code.segment.key: items
        - $match: $found
          when:
          - case:
              $code.node-result.ok:
                $bind: node
            do:
            - $let:
                changed:
                  $code.splice-sequence: $document
                  target: $node
                  start: 0
                  delete-count: 1
                  values:
                    $array:
                    - $code.form.string: changed
            - $match: $changed
              when:
              - case:
                  $code.document-result.ok:
                    $bind: output
                do:
                - $match:
                    $code.emit: $output
                  when:
                  - case: |
                      items:
                        - changed
                        - b
                    do:
                    - $test.assert: true
                  - case:
                      $wildcard: null
                    do:
                    - $test.fail: sequence splice rendered incorrectly
              - case:
                  $code.document-result.err:
                    $bind: error
                do:
                - $test.fail: sequence splice failed
          - case:
              $code.node-result.err:
                $bind: error
            do:
            - $test.fail: path lookup failed
      - case:
          $code.document-result.err:
            $bind: error
        do:
        - $test.fail: parse failed
find-returns-structural-captures:
  $test: core
  do:
    - $let:
        parsed:
          $code.parse: |
            greeting: hi
    - $match: $parsed
      when:
      - case:
          $code.document-result.ok:
            $bind: document
        do:
        - $let:
            pattern:
              $code.capture-pattern:
                $code.pattern.exact:
                  $code.form.string: hi
              name: value
        - $let:
            query:
              $code.make-query:
                $array:
                - $code.segment.key: greeting
              include-root: true
              mapping-key: greeting
              kind: scalar
              pattern: $pattern
              limit: 1
        - $let:
            found:
              $code.find: $document
              query: $query
        - $match: $found
          when:
          - case:
              $code.matches-result.ok:
                $bind: matches
            do:
            - $test.assert: true
          - case:
              $wildcard: null
            do:
            - $test.fail: query or capture did not match
      - case:
          $code.document-result.err:
            $bind: error
        do:
        - $test.fail: parse failed

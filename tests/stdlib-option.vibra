(import test "../stdlib/src/test.vibra")
(import option "../stdlib/src/option.vibra")
(test
  some-carries-payload
  core
  (do
    (let o (option.option.some 7))
    (match
      o
      (case
        (option.option.some (bind v))
        (do
          (match
            v
            (case 7 (do (test.assert true)))
            (case _ (do (test.fail "wrong some payload")))
          )
        )
      )
      (case (option.option.none) (do (test.fail "expected some")))
    )
  )
)
(test
  none-variant
  core
  (do
    (let present (option.option.some 1))
    (match
      present
      (case
        (option.option.some (bind _v))
        (do
          (let absent option.option.none)
          (match
            absent
            (case (option.option.some (bind _x)) (do (test.fail "expected none")))
            (case (option.option.none) (do (test.assert true)))
          )
        )
      )
      (case (option.option.none) (do (test.fail "expected some")))
    )
  )
)
(test
  queries-and-defaulting
  core
  (do
    (let present (option.option.some 7))
    (test.assert (option.is-some int64 present))
    (let present-value (option.unwrap-or int64 present 11))
    (match
      present-value
      (case 7 (do (test.assert true)))
      (case _ (do (test.fail "some did not preserve its value")))
    )
  )
)
(test
  and-or-combinators
  core
  (do
    (let present (option.from-value int64 1))
    (let absent (option.empty int64 false))
    (let next (option.from-value str "next"))
    (match
      (option.and int64 str present next)
      (case
        (option.option.some "next")
        (do
          (match
            (option.or int64 absent present)
            (case (option.option.some 1) (do (test.assert true)))
            (case _ (do (test.fail "option or did not select fallback")))
          )
        )
      )
      (case _ (do (test.fail "option and did not select next")))
    )
  )
)

test:
  $import: ../stdlib/src/test.vibra
process:
  $import: ../stdlib/src/process.vibra
result:
  $import: ../stdlib/src/result.vibra
executable-scope-is-attenuated:
  $test: process
  tags:
  - stdlib
  - capability
  - process
  policy:
    $policy:
      process-run:
      - requirement: mandatory
        scopes:
        - exact: vibra-process-test
  do:
  - $let:
      capability:
        $policy.narrow: $args.policy
        into: $process.run-capability
  - $let:
      outcome:
        $process.run: outside-grant
        arguments:
          $array:
          - unused
        environment:
          $map:
          - key: VIBRA_PROCESS_TEST
            value: '1'
        cwd: ''
        stdio:
          $process.stdio-policy.capture: null
        capability: $capability
  - $match: $outcome
    when:
    - case:
        $result.result.err:
          $process.process-error.permission-denied: null
      do:
      - $test.assert: true
    - case:
        $wildcard: null
      do:
      - $test.fail: executable outside process grant was not rejected

test:
  $import: ../stdlib/src/test.vibra
process:
  $import: ../stdlib/src/process.vibra
result:
  $import: ../stdlib/src/result.vibra
run-reports-the-current-unsupported-runtime:
  $test: process
  tags:
  - stdlib
  - capability
  policy:
    $policy:
      process-run:
      - requirement: mandatory
        scopes:
        - exact: echo
  do:
  - $let:
      capability:
        $policy.narrow: $args.policy
        into: $process.run-capability
  - $let:
      outcome:
        $process.run: echo
        capability: $capability
  - $match: $outcome
    when:
    - case:
        $result.result.err:
          $bind: error
      do:
      - $match: $error
        when:
        - case:
            $process.process-error.unsupported:
              $wildcard: null
          do:
          - $test.assert: true
        - case:
            $wildcard: null
          do:
          - $test.fail: expected unsupported process runtime
    - case:
        $result.result.ok: null
      do:
      - $test.fail: process runtime unexpectedly ran a command

(import test "../stdlib/src/test.vib")
(test.scenario
  "bool-literal"
  (test.case "bool-literal" (test.assert true) profile: @core)
)
(test.scenario
  "bound-bool"
  (test.case "bound-bool" (let flag true) (test.assert flag) profile: @core)
)
(test.scenario
  "int-literal"
  (test.case
    "int-literal"
    (let n 7)
    (match n 7 (do (test.assert true)) _ (do (test.fail "expected 7")))
    profile: @core
  )
)
(test.scenario
  "float-literal"
  (test.case
    "float-literal"
    (let x 1.5)
    (match x 1.5 (do (test.assert true)) _ (do (test.fail "expected 1.5")))
    profile: @core
  )
)
(test.scenario
  "string-literal"
  (test.case
    "string-literal"
    (let s "hello")
    (match s "hello" (do (test.assert true)) _ (do (test.fail "expected hello")))
    profile: @core
  )
)
(test.scenario
  "match-arm-binding-does-not-leak"
  (test.case
    "match-arm-binding-does-not-leak"
    (let outer true)
    (let subject 1)
    (match subject 1 (do (let outer false)) _ (do))
    (test.assert outer)
    profile: @core
  )
)

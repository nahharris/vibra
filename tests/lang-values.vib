(import test "../stdlib/src/test.vib")
(test.scenario
  "bool-literal"
  (test.case "bool-literal" profile: @core (test.assert true)))
(test.scenario
  "bound-bool"
  (test.case "bound-bool" profile: @core (let flag true) (test.assert flag)))
(test.scenario
  "int-literal"
  (test.case
    "int-literal"
    profile: @core
    (let n 7)
    (match n
      7 (test.assert true)
      _ (test.fail "expected 7"))))
(test.scenario
  "float-literal"
  (test.case
    "float-literal"
    profile: @core
    (let x 1.5)
    (match x
      1.5 (test.assert true)
      _ (test.fail "expected 1.5"))))
(test.scenario
  "string-literal"
  (test.case
    "string-literal"
    profile: @core
    (let s "hello")
    (match s
      "hello" (test.assert true)
      _ (test.fail "expected hello"))))

(import test "../stdlib/src/test.vibra")
(import io "../stdlib/src/io.vibra")
(import result "../stdlib/src/result.vibra")
(test
  print-statement-runs
  core
  (do
    (let r (io.print "stdout from vibra test"))
    (match
      r
      (case (result.result.ok) (do (test.assert true)))
      (case (result.result.err _) (do (test.fail "print returned err")))
    )
  )
)
(test
  println-returns-ok
  core
  (do
    (let r (io.println "line from vibra test"))
    (match
      r
      (case (result.result.ok) (do (test.assert true)))
      (case (result.result.err _) (do (test.fail "println returned err")))
    )
  )
)
(test
  eprintln-statement-runs
  core
  (do
    (let r (io.eprintln "stderr from vibra test"))
    (match
      r
      (case (result.result.ok) (do (test.assert true)))
      (case (result.result.err _) (do (test.fail "eprintln returned err")))
    )
  )
)

(import test "../stdlib/src/test.vib")
(import text "../stdlib/src/text.vib")
(import option "../stdlib/src/option.vib")
(import result "../stdlib/src/result.vib")
(test.scenario
  "unicode-units-and-search"
  (test.case
    "unicode-units-and-search"
    profile: @core
    (test.assert-eq-int (convert (text.scalar-len "aé🙂") int64 0) 3)
    (test.assert-eq-int (convert (text.byte-len "aé🙂") int64 0) 7)
    (let found (text.find "aé🙂" "🙂"))
    (match found
      (option.option.some 2) (test.assert true)
      _ (test.fail "find did not return a scalar offset"))))
(test.scenario
  "queries-and-empty-input"
  (test.case
    "queries-and-empty-input"
    profile: @core
    (test.assert (text.is-empty ""))
    (test.assert (text.contains "alphabet" "pha"))
    (test.assert (text.starts-with "alphabet" "alpha"))
    (test.assert (text.ends-with "alphabet" "bet"))
    (let missing (text.scalar-at "aé" 2))
    (match missing
      (option.option.none) (test.assert true)
      _ (test.fail "scalar-at must be bounds safe"))))
(test.scenario
  "split-trim-replace-join-and-case"
  (test.case
    "split-trim-replace-join-and-case"
    profile: @core
    (let split (text.split "a,,b," ","))
    (match split
      (result.result.ok (array "a" "" "b" "")) (test.assert true)
      _ (test.fail "split did not preserve empty fields"))
    (let joined (text.join (array "a" "b" "c") "-"))
    (match joined
      (result.result.ok "a-b-c") (test.assert true)
      _ (test.fail "join failed"))
    (let replaced (text.replace "aéa" "a" "zz"))
    (match replaced
      (result.result.ok "zzézz") (test.assert true)
      _ (test.fail "replace failed"))
    (let invalid (text.replace "abc" "" "x"))
    (match invalid
      (result.result.err (text.text-error.empty-pattern)) (test.assert true)
      _ (test.fail "empty replacement pattern was not typed"))
    (let trimmed (text.trim "  hé  "))
    (match trimmed
      (result.result.ok "hé") (test.assert true)
      _ (test.fail "trim failed"))
    (let upper (text.uppercase "Straße"))
    (match upper
      (result.result.ok "STRASSE") (test.assert true)
      _ (test.fail "Unicode uppercase failed"))))

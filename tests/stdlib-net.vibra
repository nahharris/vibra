test:
  $import: ../stdlib/src/test.vibra
net:
  $import: ../stdlib/src/net.vibra
result:
  $import: ../stdlib/src/result.vibra
connect-reports-the-current-unsupported-runtime:
  $test: net
  tags:
  - stdlib
  - capability
  policy:
    $policy:
      net-connect:
      - requirement: mandatory
        scopes:
        - exact: 127.0.0.1:9
  do:
  - $let:
      capability:
        $policy.narrow: $args.policy
        into: $net.connect-capability
  - $let:
      outcome:
        $net.connect: 127.0.0.1:9
        capability: $capability
  - $match: $outcome
    when:
    - case:
        $result.result.err:
          $bind: error
      do:
      - $match: $error
        when:
        - case:
            $net.net-error.unsupported:
              $wildcard: null
          do:
          - $test.assert: true
        - case:
            $wildcard: null
          do:
          - $test.fail: expected unsupported network runtime
    - case:
        $result.result.ok: null
      do:
      - $test.fail: network runtime unexpectedly connected

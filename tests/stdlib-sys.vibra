(import test "../stdlib/src/test.vibra")
(import sys "../stdlib/src/sys.vibra")
(import result "../stdlib/src/result.vibra")
(fn accepts-args ((value (array str))) bool (do (return true)))
(fn accepts-info ((value sys.info-record)) bool (do (return true)))
(test
  info-uses-the-granted-system-capability
  system
  (do
    (let capability (policy.narrow policy sys.capability))
    (let info (sys.info capability))
    (let info-has-the-declared-type (accepts-info info))
    (test.assert info-has-the-declared-type)
    (let args (sys.args capability))
    (let args-have-the-declared-type (accepts-args args))
    (test.assert args-have-the-declared-type)
    (let temp-dir (sys.temp-dir capability))
    (test.assert-eq-str temp-dir temp-dir)
    (let cwd (sys.current-dir capability))
    (match
      cwd
      (case (result.result.ok _) (do (test.assert true)))
      (case
        (result.result.err _)
        (do (test.fail "current directory was unavailable"))
      )
    )
  )
  tags: (stdlib capability)
  policy: (policy (system-info (group requirement: mandatory scopes: ((any)))))
)

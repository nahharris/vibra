test:
  $import: ../stdlib/src/test.vibra
sys:
  $import: ../stdlib/src/sys.vibra
info-uses-the-granted-system-capability:
  $test: system
  tags:
  - stdlib
  - capability
  policy:
    $policy:
      system-info:
      - requirement: mandatory
        scopes: any
  do:
  - $let:
      capability:
        $policy.narrow: $args.policy
        into: $sys.capability
  - $let:
      info:
        $sys.info:
          capability: $capability
  - $test.assert-eq-str:
      actual: $info
      expected: $info

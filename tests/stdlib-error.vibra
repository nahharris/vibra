(import test "../stdlib/src/test.vibra")
(import error "../stdlib/src/error.vibra")
(import env "../stdlib/src/env.vibra")
(import fs "../stdlib/src/fs.vibra")
(test
  context-preserves-structured-detail
  core
  (do
    (let kind (error.error-kind.io))
    (match
      kind
      (case (error.error-kind.io) (do (test.assert true)))
      (case _ (do (test.fail "error context lost structured detail")))
    )
  )
)
(test
  host-errors-share-kind-contract
  core
  (do
    (let missing-file (fs.fs-error.not-found))
    (let invalid-env (env.env-error.invalid-name))
    (match
      (fs.error-kind missing-file)
      (case
        (error.error-kind.not-found)
        (do
          (match
            (env.error-kind invalid-env)
            (case (error.error-kind.invalid-input) (do (test.assert true)))
            (case _ (do (test.fail "env error kind was not normalized")))
          )
        )
      )
      (case _ (do (test.fail "filesystem error kind was not normalized")))
    )
  )
)

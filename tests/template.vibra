(import test "../stdlib/src/test.vibra")
(test.scenario
  "compile-time-template-renders-sections"
  (test.case
    "compile-time-template-renders-sections"
    (let
      rendered
      (template
        "template-assets/greeting.txt"
        with: (record
          (greeting "Hello")
          (people (array (record (name "Ada")) (record (name "Lin"))))
        )
      )
    )
    (match
      rendered
      "Hello: Ada, Lin, \n"
      (do (test.assert true))
      _
      (do (test.fail "compile-time template rendered unexpected text"))
    )
    profile: core
  )
)

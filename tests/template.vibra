(import test "../stdlib/src/test.vibra")
(test
  compile-time-template-renders-sections
  core
  (do
    (let
      rendered
      (template
        "template-assets/greeting.txt"
        with: (record
          (greeting "Hello")
          (people (array (record (name "Ada")) (record (name "Lin"))))
        )
      )
    )
    (match
      rendered
      (case "Hello: Ada, Lin, \n" (do (test.assert true)))
      (case _ (do (test.fail "compile-time template rendered unexpected text")))
    )
  )
)

(import test "../stdlib/src/test.vib")
(import convert "../stdlib/src/convert.vib")
(defn classify-atom (value atom) bool
  (match value
    @ok (return true)
    _ (return false)))
(defn exact-atom () @ok
  (return @ok))
(defn atom-keyed-map () (map atom int64)
  (return (map (@ok 1) (@error 2))))
(test.scenario
  "first-class-atoms"
  (test.case
    "atom-equality"
    profile: @core
    (test.assert (equal @ok @ok))
    (test.assert (not-equal @ok @error))
    (test.assert (equal @http.not-found @http.not-found)))
  (test.case
    "atom-patterns-and-singletons"
    profile: @core
    (test.assert (classify-atom @ok))
    (test.assert (not (classify-atom @error)))
    (test.assert (equal (exact-atom) @ok)))
  (test.case
    "atom-keyed-maps"
    profile: @core
    (match (atom-keyed-map)
      (map (@ok 1) (@error 2)) (test.assert true)
      _ (test.fail "atom-keyed map did not match")))
  (test.case
    "atom-rendering"
    profile: @core
    (test.assert-eq-str (convert.format-atom @ok) "@ok")
    (test.assert-eq-str (convert.format-atom @http.not-found) "@http.not-found")))

(import test "../stdlib/src/test.vibra")
(fn truthy () bool (do (return true)))
(fn echo-int ((subject int64)) int64 (do (return subject)))
(test many-1 core (do (test.assert true)))
(test many-2 core (do (let flag true) (test.assert flag)))
(test many-3 core (do (let v (truthy)) (test.assert v)))
(test
  many-4
  core
  (do
    (let n (echo-int 4))
    (match
      n
      (case 4 (do (test.assert true)))
      (case _ (do (test.fail "expected 4")))
    )
  )
)
(test
  many-5
  core
  (do
    (let n (echo-int 5))
    (match
      n
      (case 5 (do (test.assert true)))
      (case _ (do (test.fail "expected 5")))
    )
  )
)
(test
  many-6
  core
  (do
    (let s "shared-context")
    (match
      s
      (case "shared-context" (do (test.assert true)))
      (case _ (do (test.fail "expected shared-context")))
    )
  )
)
(test
  many-7
  core
  (do
    (let x 2.5)
    (match
      x
      (case 2.5 (do (test.assert true)))
      (case _ (do (test.fail "expected 2.5")))
    )
  )
)
(test many-8 core (do (let v (truthy)) (test.assert v)))
(test many-9 core (do (test.assert true)))
(test
  many-10
  core
  (do
    (let n (echo-int 10))
    (match
      n
      (case 10 (do (test.assert true)))
      (case _ (do (test.fail "expected 10")))
    )
  )
)
(test many-11 core (do (let flag true) (test.assert flag)))
(test
  many-12
  core
  (do
    (let n (echo-int 12))
    (match
      n
      (case 12 (do (test.assert true)))
      (case _ (do (test.fail "expected 12")))
    )
  )
)

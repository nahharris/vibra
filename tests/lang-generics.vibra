(import test "../stdlib/src/test.vibra")
(fn identity ((subject t)) t (do (return subject)) where: ((t)))
(fn first-of ((subject t) (other u)) t (do (return subject)) where: ((t) (u)))
(test identity-bool core (do (let x (identity bool true)) (test.assert x)))
(test
  identity-int
  core
  (do
    (let n (identity int64 5))
    (match
      n
      (case 5 (do (test.assert true)))
      (case _ (do (test.fail "expected 5")))
    )
  )
)
(test
  two-type-params
  core
  (do (let r (first-of bool str true "ignored")) (test.assert r))
)

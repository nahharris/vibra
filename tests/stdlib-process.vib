(import test "../stdlib/src/test.vib")
(import process "../stdlib/src/process.vib")
(import result "../stdlib/src/result.vib")
(test.scenario
  "run-rejects-stream-stdio-without-spawning"
  (test.case
    "run-rejects-stream-stdio-without-spawning"
    profile: @process
    tags: (@stdlib @process)
    (let
      outcome
      (process.run
        (record
          (executable "vibra-process-test")
          (arguments (array "unused"))
          (environment (map ("VIBRA_PROCESS_TEST" "1")))
          (cwd "")
          (stdio (process.stdio-policy.stream)))))
    (match outcome
      (result.result.err (process.process-error.unsupported _)) (test.assert true)
      _ (test.fail "run stream mode was not rejected as unsupported"))))

(import test "../stdlib/src/test.vibra")
(test
  if-true-takes-then
  core
  (do
    (if true (do (test.assert true)) (do (test.fail "then branch was skipped")))
  )
)
(test
  if-false-takes-else
  core
  (do
    (if false (do (test.fail "then branch ran on false")) (do (test.assert true)))
  )
)
(test
  if-on-bound-condition
  core
  (do
    (let flag true)
    (if
      flag
      (do (test.assert true))
      (do (test.fail "bound true condition took else"))
    )
  )
)
(test
  nested-if
  core
  (do
    (if
      true
      (do
        (if false (do (test.fail "inner false took then")) (do (test.assert true)))
      )
      (do (test.fail "outer true took else"))
    )
  )
)
(test
  while-false-never-runs
  core
  (do
    (while false (do (test.fail "while body ran on false condition")))
    (test.assert true)
  )
)

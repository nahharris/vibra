(import test "../stdlib/src/test.vibra")
(test
  literal-int-arm
  core
  (do
    (let n 3)
    (match
      n
      (case 1 (do (test.fail "matched 1")))
      (case 3 (do (test.assert true)))
      (case _ (do (test.fail "fell through to wildcard")))
    )
  )
)
(test
  literal-string-arm
  core
  (do
    (let s "b")
    (match
      s
      (case "a" (do (test.fail "matched a")))
      (case "b" (do (test.assert true)))
      (case _ (do (test.fail "fell through")))
    )
  )
)
(test
  bool-arm
  core
  (do
    (let flag false)
    (match
      flag
      (case true (do (test.fail "matched true")))
      (case false (do (test.assert true)))
      (case _ (do (test.fail "fell through bool match")))
    )
  )
)
(test
  wildcard-catch-all
  core
  (do
    (let n 99)
    (match
      n
      (case 0 (do (test.fail "matched 0")))
      (case _ (do (test.assert true)))
    )
  )
)
(test
  bind-captures-value
  core
  (do
    (let n 8)
    (match
      n
      (case 7 (do (test.fail "matched 7")))
      (case
        (bind captured)
        (do
          (match
            captured
            (case 8 (do (test.assert true)))
            (case _ (do (test.fail "wrong captured value")))
          )
        )
      )
      (case _ (do (test.fail "fell through to wildcard")))
    )
  )
)

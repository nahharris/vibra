(import test "../stdlib/src/test.vibra")
(def signal (enum (stop void) (go int64)))
(def opt (enum (none void) (some str)))
(test.scenario
  "construct-and-match-payload"
  (test.case
    "construct-and-match-payload"
    (let s (signal.go 3))
    (match
      s
      (signal.go (bind speed))
      (do (match speed 3 (test.assert true) _ (test.fail "wrong payload")))
      (signal.stop)
      (do (test.fail "expected go"))
    )
    profile: core
  )
)
(test.scenario
  "void-variant-constructor"
  (test.case
    "void-variant-constructor"
    (let s signal.stop)
    (match
      s
      (signal.stop)
      (do (test.assert true))
      (signal.go _)
      (do (test.fail "expected stop"))
    )
    profile: core
  )
)
(test.scenario
  "option-like-some"
  (test.case
    "option-like-some"
    (let v (opt.some "hi"))
    (match
      v
      (opt.some (bind text))
      (do (match text "hi" (test.assert true) _ (test.fail "wrong text")))
      (opt.none)
      (do (test.fail "expected some"))
    )
    profile: core
  )
)
(test.scenario
  "option-like-none"
  (test.case
    "option-like-none"
    (let v opt.none)
    (match
      v
      (opt.some _)
      (do (test.fail "expected none"))
      (opt.none)
      (do (test.assert true))
    )
    profile: core
  )
)

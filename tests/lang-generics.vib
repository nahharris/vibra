(import test "../stdlib/src/test.vib")
(defn identity (subject t) t
  where: (t any)
  (return subject))
(defn first-of (subject t other u) t
  where: (t any u any)
  (return subject))
(test.scenario
  "identity-bool"
  (test.case
    "identity-bool"
    profile: @core
    (let x (identity bool true))
    (test.assert x)))
(test.scenario
  "identity-int"
  (test.case
    "identity-int"
    profile: @core
    (let n (identity int64 5))
    (match n
      5 (test.assert true)
      _ (test.fail "expected 5"))))
(test.scenario
  "two-type-params"
  (test.case
    "two-type-params"
    profile: @core
    (let r (first-of bool str true "ignored"))
    (test.assert r)))

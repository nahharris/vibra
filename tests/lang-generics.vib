(import test "../stdlib/src/test.vib")
(defn identity (subject t) t (return subject) where: (t any))
(defn first-of (subject t other u) t (return subject) where: (t any u any))
(test.scenario
  "identity-bool"
  (test.case
    "identity-bool"
    (let x (identity bool true))
    (test.assert x)
    profile: @core
  )
)
(test.scenario
  "identity-int"
  (test.case
    "identity-int"
    (let n (identity int64 5))
    (match n 5 (do (test.assert true)) _ (do (test.fail "expected 5")))
    profile: @core
  )
)
(test.scenario
  "two-type-params"
  (test.case
    "two-type-params"
    (let r (first-of bool str true "ignored"))
    (test.assert r)
    profile: @core
  )
)

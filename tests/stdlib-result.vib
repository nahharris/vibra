(import test "../stdlib/src/test.vib")
(import result "../stdlib/src/result.vib")
(import option "../stdlib/src/option.vib")
(test.scenario
  "ok-carries-payload"
  (test.case
    "ok-carries-payload"
    profile: @core
    (let r (result.result.ok 99))
    (match r
      (result.result.ok (bind v))
        (match v
          99 (test.assert true)
          _ (test.fail "wrong ok payload"))
      (result.result.err _) (test.fail "expected ok"))))
(test.scenario
  "err-carries-payload"
  (test.case
    "err-carries-payload"
    profile: @core
    (let r (result.result.err "boom"))
    (match r
      (result.result.ok _) (test.fail "expected err")
      (result.result.err (bind e))
        (match e
          "boom" (test.assert true)
          _ (test.fail "wrong err payload")))))
(test.scenario
  "queries-defaulting-and-option-conversion"
  (test.case
    "queries-defaulting-and-option-conversion"
    profile: @core
    (let success (result.from-ok int64 str 5))
    (let failure (result.from-err int64 str "boom"))
    (test.assert (result.is-ok int64 str success))
    (test.assert (result.is-err int64 str failure))
    (let fallback (result.unwrap-or int64 str failure 9))
    (let value-option (result.into-ok-option int64 str success))
    (let error-option (result.into-err-option int64 str failure))
    (match value-option
      (option.option.some 5)
        (match error-option
          (option.option.some "boom")
            (match fallback
              9 (test.assert true)
              _ (test.fail "err did not use default"))
          _ (test.fail "err conversion lost error"))
      _ (test.fail "ok conversion lost value"))))
(test.scenario
  "and-or-preserve-error-types"
  (test.case
    "and-or-preserve-error-types"
    profile: @core
    (let failure (result.from-err int64 str "original"))
    (let next (result.from-ok bool str true))
    (let chained (result.and int64 bool str failure next))
    (match chained
      (result.result.err "original")
        (match (result.or int64 str bool failure (result.from-ok int64 bool 9))
          (result.result.ok 9) (test.assert true)
          _ (test.fail "result or did not select fallback"))
      _ (test.fail "result and did not preserve the original error"))))

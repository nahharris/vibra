(import test "../stdlib/src/test.vibra")
(import random "../stdlib/src/random.vibra")
(test
  bytes-uses-the-granted-random-source
  random
  (do
    (let capability (policy.narrow policy random.capability))
    (let value (random.bytes 8 capability))
    (let raw (cast value (array uint8)))
    (match
      raw
      (case (array _ _ _ _ _ _ _ _) (do (test.assert true)))
      (case _ (do (test.fail "random bytes returned the wrong length")))
    )
  )
  tags: (stdlib capability)
  policy: (policy (random (group requirement: mandatory scopes: ((any)))))
)

(import test "../stdlib/src/test.vibra")
(import random "../stdlib/src/random.vibra")
(test.scenario
  "bytes-uses-the-random-source"
  (test.case
    "bytes-uses-the-random-source"
    (let value (random.generate.bytes 8))
    (let raw (cast value (array uint8)))
    (match
      raw
      (array _ _ _ _ _ _ _ _)
      (do (test.assert true))
      _
      (do (test.fail "random bytes returned the wrong length"))
    )
    profile: @random
    tags: (@stdlib)
  )
)

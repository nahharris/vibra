(import test "../stdlib/src/test.vibra")
(test bool-literal core (do (test.assert true)))
(test bound-bool core (do (let flag true) (test.assert flag)))
(test
  int-literal
  core
  (do
    (let n 7)
    (match
      n
      (case 7 (do (test.assert true)))
      (case _ (do (test.fail "expected 7")))
    )
  )
)
(test
  float-literal
  core
  (do
    (let x 1.5)
    (match
      x
      (case 1.5 (do (test.assert true)))
      (case _ (do (test.fail "expected 1.5")))
    )
  )
)
(test
  string-literal
  core
  (do
    (let s "hello")
    (match
      s
      (case "hello" (do (test.assert true)))
      (case _ (do (test.fail "expected hello")))
    )
  )
)
(test
  match-arm-binding-does-not-leak
  core
  (do
    (let outer true)
    (let subject 1)
    (match subject (case 1 (do (let outer false))) (case _ (do)))
    (test.assert outer)
  )
)

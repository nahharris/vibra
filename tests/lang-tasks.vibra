(import test "../stdlib/src/test.vibra")
(test
  structured-task-captures-immutable-snapshot
  core
  (do
    (let answer 42)
    (task
      (captures answer)
      (do
        (match
          answer
          (case 42 (do (test.assert true)))
          (case _ (do (test.fail "task capture changed")))
        )
      )
    )
  )
  tags: (language tasks)
)
(test
  structured-task-rejects-mutable-capture
  core
  (do (let count (mut 0)) (task (captures count) (do)))
  tags: (language tasks diagnostics)
  expect-error: (compile E-TASK-001 "immutable snapshot")
)
(test
  spawned-task-handles-overlap-and-join-out-of-order
  core
  (do
    (let base 40)
    (spawn first (captures base) (add base 1))
    (spawn second (captures base) (add base 2))
    (join second second-result)
    (join first first-result)
    (test.assert-eq-int second-result 42)
    (test.assert-eq-int first-result 41)
  )
  tags: (language tasks)
)
(test
  spawned-task-handle-is-affine
  core
  (do (spawn answer (captures) 42) (join answer once) (join answer twice))
  tags: (language tasks diagnostics)
  expect-error: (compile E-TASK-003 "unknown or was already joined")
)
(test
  spawned-task-handle-cannot-be-copied
  core
  (do (spawn answer (captures) 42) (let copy answer) (join answer result))
  tags: (language tasks diagnostics)
  expect-error: (compile E-TASK-003 "consume it with `$join`")
)
(test
  spawned-task-must-be-joined-before-scope-exit
  core
  (do (spawn abandoned (captures) 42))
  tags: (language tasks diagnostics)
  expect-error: (compile E-TASK-003 "must be joined")
)

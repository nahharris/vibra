test:
  $import: ../stdlib/src/test.vibra
time:
  $import: ../stdlib/src/time.vibra
result:
  $import: ../stdlib/src/result.vibra
accepts-unix-millis:
  $function:
    value: $uint64
  return: $bool
  do:
  - $return: true
accepts-duration:
  $function:
    value: $time.duration
  return: $bool
  do:
  - $return: true
now-unix-millis-uses-the-granted-clock:
  $test: system
  tags:
  - stdlib
  - capability
  policy:
    $policy:
      clock:
      - requirement: mandatory
        scopes: any
  do:
  - $let:
      capability:
        $policy.narrow: $args.policy
        into: $time.capability
  - $let:
      now:
        $time.now-unix-millis:
          capability: $capability
  - $let:
      is-millis:
        $accepts-unix-millis: $now
  - $test.assert: $is-millis
  - $let:
      start:
        $time.monotonic-now:
          capability: $capability
  - $time.sleep:
      duration:
        $time.milliseconds: 0
      capability: $capability
  - $let:
      finish:
        $time.monotonic-now:
          capability: $capability
  - $let:
      elapsed:
        $time.duration-between:
          earlier: $start
          later: $finish
  - $match: $elapsed
    when:
    - case:
        $result.result.ok:
          $bind: duration
      do:
      - $let:
          is-duration:
            $accepts-duration: $duration
      - $test.assert: $is-duration
    - case:
        $result.result.err:
          $wildcard: null
      do:
      - $test.fail: monotonic clock moved backwards

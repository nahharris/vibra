(import test "../stdlib/src/test.vibra")
(fn ready () bool (do (return true)))
(fn echo-bool ((subject bool)) bool (do (return subject)))
(fn second ((a bool) (b bool)) bool (do (return b)))
(fn check () bool (do (let r (ready)) (return r)))
(test zero-arg-call core (do (let v (ready)) (test.assert v)))
(test single-arg-call core (do (let v (echo-bool true)) (test.assert v)))
(test multi-arg-call core (do (let v (second false true)) (test.assert v)))
(test nested-call core (do (let v (check)) (test.assert v)))

(import test "../stdlib/src/test.vibra")
(import bytes "../stdlib/src/bytes.vibra")
(import option "../stdlib/src/option.vibra")
(import result "../stdlib/src/result.vibra")
(test
  utf8-round-trip-and-byte-lookup
  core
  (do
    (let encoded (bytes.bytes.from-str "aé"))
    (test.assert-eq-int (bytes.bytes.len encoded) 3)
    (let byte (bytes.bytes.get encoded 1))
    (match
      byte
      (case (option.option.some 195) (do (test.assert true)))
      (case _ (do (test.fail "byte lookup failed")))
    )
    (let decoded (bytes.bytes.decode-utf8 encoded))
    (match
      decoded
      (case (result.result.ok "aé") (do (test.assert true)))
      (case _ (do (test.fail "UTF-8 round trip failed")))
    )
  )
)
(test
  concat-search-and-invalid-utf8
  core
  (do
    (let left (bytes.bytes.from-str "abc"))
    (let right (bytes.bytes.from-str "dé"))
    (let joined (bytes.bytes.concat left right))
    (match
      joined
      (case
        (result.result.ok (bind combined))
        (do
          (let found (bytes.bytes.find combined right))
          (match
            found
            (case (option.option.some 3) (do (test.assert true)))
            (case _ (do (test.fail "byte search failed")))
          )
        )
      )
      (case _ (do (test.fail "byte concat failed")))
    )
    (let raw (cast (array 255) bytes.bytes))
    (let invalid (bytes.bytes.decode-utf8 raw))
    (match
      invalid
      (case
        (result.result.err (bytes.bytes-error.invalid-utf8))
        (do (test.assert true))
      )
      (case _ (do (test.fail "malformed UTF-8 was not rejected")))
    )
  )
)

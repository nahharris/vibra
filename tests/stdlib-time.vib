(import test "../stdlib/src/test.vib")
(import time "../stdlib/src/time.vib")
(import result "../stdlib/src/result.vib")
(defn accepts-unix-millis (value uint64) bool (return true))
(defn accepts-duration (value time.duration) bool (return true))
(test.scenario
  "now-unix-millis-reads-the-clock"
  (test.case
    "now-unix-millis-reads-the-clock"
    (let now (time.now.unix-millis))
    (let is-millis (accepts-unix-millis now))
    (test.assert is-millis)
    (let start (time.now.monotonic-millis))
    (time.sleep.for (time.milliseconds 0))
    (let finish (time.now.monotonic-millis))
    (let elapsed (time.duration-between start finish))
    (match
      elapsed
      (result.result.ok (bind duration))
      (do (let is-duration (accepts-duration duration)) (test.assert is-duration))
      (result.result.err _)
      (do (test.fail "monotonic clock moved backwards"))
    )
    profile: @system
    tags: (@stdlib)
  )
)

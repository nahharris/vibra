(import test "../stdlib/src/test.vib")
(def meters (newtype int64))
(def label (newtype str))
(test.scenario
  "cast-into-newtype"
  (test.case
    "cast-into-newtype"
    profile: @core
    (let d (cast 10 meters))
    (match d
      (newtype meters (bind raw))
        (match raw
          10 (test.assert true)
          _ (test.fail "wrong inner value"))
      _ (test.fail "expected meters newtype"))))
(test.scenario
  "cast-string-newtype"
  (test.case
    "cast-string-newtype"
    profile: @core
    (let l (cast "north" label))
    (match l
      (newtype label (bind raw))
        (match raw
          "north" (test.assert true)
          _ (test.fail "wrong inner string"))
      _ (test.fail "expected label newtype"))))

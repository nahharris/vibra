(import test "../stdlib/src/test.vib")
(import time "../stdlib/src/time.vib")
(test.scenario
  "program-authority"
  (test.case
    "denies-an-undeclared-clock-grant"
    (let now (time.now.unix-millis))
    (test.assert true)
    profile: @capability
    tags: (@language @capability)
    expect-error: (@runtime "E-CAPABILITY-001")
  )
)

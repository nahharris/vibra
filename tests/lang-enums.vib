(import test "../stdlib/src/test.vib")
(def signal (enum (stop void) (go int64)))
(def opt (enum (none void) (some str)))
(test.scenario
  "construct-and-match-payload"
  (test.case
    "construct-and-match-payload"
    profile: @core
    (let s (signal.go 3))
    (match s
      (signal.go (bind speed))
        (match speed
          3 (test.assert true)
          _ (test.fail "wrong payload"))
      (signal.stop) (test.fail "expected go"))))
(test.scenario
  "void-variant-constructor"
  (test.case
    "void-variant-constructor"
    profile: @core
    (let s signal.stop)
    (match s
      (signal.stop) (test.assert true)
      (signal.go _) (test.fail "expected stop"))))
(test.scenario
  "option-like-some"
  (test.case
    "option-like-some"
    profile: @core
    (let v (opt.some "hi"))
    (match v
      (opt.some (bind text))
        (match text
          "hi" (test.assert true)
          _ (test.fail "wrong text"))
      (opt.none) (test.fail "expected some"))))
(test.scenario
  "option-like-none"
  (test.case
    "option-like-none"
    profile: @core
    (let v opt.none)
    (match v
      (opt.some _) (test.fail "expected none")
      (opt.none) (test.assert true))))

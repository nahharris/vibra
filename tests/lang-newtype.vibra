(import test "../stdlib/src/test.vibra")
(def meters (newtype int64))
(def label (newtype str))
(test.scenario
  "cast-into-newtype"
  (test.case
    "cast-into-newtype"
    (let d (cast 10 meters))
    (match
      d
      (newtype meters (bind raw))
      (do (match raw 10 (test.assert true) _ (test.fail "wrong inner value")))
      _
      (do (test.fail "expected meters newtype"))
    )
    profile: @core
  )
)
(test.scenario
  "cast-string-newtype"
  (test.case
    "cast-string-newtype"
    (let l (cast "north" label))
    (match
      l
      (newtype label (bind raw))
      (do
        (match raw "north" (test.assert true) _ (test.fail "wrong inner string"))
      )
      _
      (do (test.fail "expected label newtype"))
    )
    profile: @core
  )
)
